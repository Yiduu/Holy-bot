+      .eq('is_active', true)
+      .select('id, remind_paused')
+      .maybeSingle();
+    if (error) return res.status(500).json({ error: error.message });
+    if (!data) return res.status(404).json({ error: 'Mentee not found' });
+    res.json(data);
+  });
