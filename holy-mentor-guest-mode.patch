@@ -0,0 +1,62 @@
+/* Guest mode (mentor previews the app as a mentee). Built on the app's own
+   tokens, so it follows the light and dark themes automatically. */
+
+/* ── entry card (My Mentees page) ── */
+.guest-entry { border: 1px dashed var(--border); background: var(--surface); }
+.guest-entry-head { display: flex; gap: 12px; align-items: flex-start; margin-bottom: 14px; }
+.guest-entry-icon {
+  flex: 0 0 auto; width: 38px; height: 38px; border-radius: 12px; display: grid; place-items: center;
+  color: var(--gold); background: var(--gold-dim);
+}
+.guest-entry-title { font-weight: 700; color: var(--text); font-size: var(--fs-md, 16px); }
+.guest-entry-sub { color: var(--text2); font-size: var(--fs-sm, 13px); line-height: 1.45; margin-top: 2px; }
+.guest-entry-label { color: var(--text3); font-size: var(--fs-xs, 12px); font-weight: 700; letter-spacing: .04em; text-transform: uppercase; margin-bottom: 8px; }
+.guest-chips { display: flex; gap: 8px; flex-wrap: wrap; }
+.guest-chip {
+  flex: 1 1 0; min-width: 84px; min-height: 40px; padding: 8px 12px; border-radius: 999px; cursor: pointer;
+  border: 1px solid var(--border-dim); background: transparent; color: var(--text2); font: inherit; font-weight: 600;
+}
+.guest-chip.is-on { border-color: var(--gold); color: var(--gold); background: var(--gold-dim); }
+.guest-chip:focus-visible, .guest-act:focus-visible, .guest-exit:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
+.guest-entry-note { color: var(--text3); font-size: var(--fs-xs, 12px); margin: 10px 0 14px; line-height: 1.4; }
+.guest-start { width: 100%; }
+
+/* ── preview bar: always visible while in guest mode ── */
+.guest-bar {
+  position: fixed; left: 0; right: 0; top: 0; z-index: 8000;
+  padding: calc(var(--safe-top, 0px) + 6px) 12px 8px;
+  background: rgba(var(--bg2-rgb), .96); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
+  border-bottom: 1px solid var(--gold); box-shadow: var(--shadow-sm);
+}
+.guest-bar-main { display: flex; align-items: center; gap: 8px; min-height: 32px; }
+.guest-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--gold); flex: 0 0 auto; box-shadow: 0 0 0 4px var(--gold-dim); }
+.guest-bar-text { flex: 1; min-width: 0; color: var(--text); font-size: var(--fs-xs, 12px); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.guest-bar-text span { color: var(--text2); }
+.guest-exit, .guest-act {
+  min-height: 32px; padding: 4px 12px; border-radius: 999px; cursor: pointer; font: inherit; font-size: var(--fs-xs, 12px); font-weight: 700;
+  border: 1px solid var(--gold); color: var(--gold); background: transparent;
+}
+.guest-exit { color: var(--text); border-color: var(--border-dim); }
+.guest-bar-actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 6px; }
+.guest-act { background: var(--gold-dim); }
+
+/* push the app down so the bar never covers a header */
+body.guest-mode #app { padding-top: calc(var(--safe-top, 0px) + 48px); }
+body.guest-mode #guestBar:has(.guest-bar-actions) ~ #app { padding-top: calc(var(--safe-top, 0px) + 92px); }
+
+/* chat is read-only in the preview */
+body.guest-mode #chatInputRow { display: none !important; }
+
+/* ── goal composer sheet ── */
+.guest-sheet { position: fixed; inset: 0; z-index: 8500; display: flex; flex-direction: column; background: var(--bg); }
+.guest-sheet-head {
+  display: flex; align-items: center; justify-content: space-between; gap: 12px;
+  padding: calc(var(--safe-top, 0px) + 10px) 14px 10px; border-bottom: 1px solid var(--border-dim);
+}
+.guest-sheet-title { font-weight: 700; color: var(--text); }
+.guest-sheet-body { flex: 1; overflow-y: auto; padding: 14px 14px calc(var(--safe-bottom, 0px) + 24px); -webkit-overflow-scrolling: touch; }
+
+@media (prefers-reduced-motion: no-preference) {
+  .guest-bar { animation: guestIn .22s ease-out; }
+  @keyframes guestIn { from { transform: translateY(-100%); } to { transform: none; } }
+}
