+
+/* ─── Home: premium Verse card + gold Streak card with day boxes ───────────
+   Brand colours unchanged (gold on dark navy). The streak card stays gold foil
+   in dark AND light mode; the day boxes are dark so they stand out on it. */
+
+/* Verse card */
+.verse-card {
+  border-radius: 30px;
+  padding: 22px 22px 20px;
+  background: linear-gradient(160deg, #181b26 0%, #0f1118 100%);
+  border: 1px solid rgba(201, 168, 76, 0.32);
+  box-shadow: 0 18px 44px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 233, 160, 0.14);
+}
+.verse-card::after {
+  content: '';
+  position: absolute;
+  top: -90px; right: -70px;
+  width: 240px; height: 240px;
+  border-radius: 50%;
+  background: radial-gradient(circle, rgba(232, 201, 107, 0.26), rgba(201, 168, 76, 0) 68%);
+  pointer-events: none;
+}
+.verse-card::before {
+  content: '\201C';
+  top: 44px; left: 20px;
+  font-size: 4.6rem;
+  line-height: 0.8;
+  opacity: 1;
+  background: linear-gradient(180deg, #EBCD72, #A87C2A);
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+}
+.verse-card-head { justify-content: flex-start; margin-bottom: 4px; }
+.verse-badge {
+  width: 30px; height: 30px;
+  background: radial-gradient(circle at 30% 25%, #f1d786, #c9a84c 70%);
+  color: #2a1e05;
+}
+.verse-badge svg { width: 15px; height: 15px; }
+.verse-eyebrow { font-size: 0.7rem; }
+.verse-date { margin-left: auto; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em; color: var(--text3); text-transform: uppercase; }
+.verse-text {
+  margin-top: 38px;
+  font-family: 'Cormorant Garamond', Georgia, serif;
+  font-style: italic;
+  font-weight: 600;
+  font-size: 1.6rem;
+  line-height: 1.28;
+  padding-left: 0;
+}
+.verse-text.is-am { font-family: var(--font-body); font-style: normal; font-weight: 600; font-size: 1.1rem; line-height: 1.6; }
+.verse-divider { display: none; }
+.verse-ref {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  margin-top: 16px;
+  font-size: 0.82rem;
+  letter-spacing: 0.1em;
+  color: var(--gold-light);
+  text-transform: uppercase;
+  position: relative;
+  z-index: 1;
+}
+.verse-ref::before { content: ''; width: 28px; height: 1.5px; background: linear-gradient(90deg, #C9A84C, rgba(201, 168, 76, 0)); }
+[data-theme="light"] .verse-card {
+  background: linear-gradient(160deg, #FFFDF7 0%, #F3EAD8 100%);
+  border-color: rgba(184, 134, 11, 0.42);
+  box-shadow: 0 16px 36px rgba(120, 85, 15, 0.2), inset 0 1px 0 #fff;
+}
+[data-theme="light"] .verse-eyebrow, [data-theme="light"] .verse-ref { color: #7A5812; }
+[data-theme="light"] .verse-date { color: #8a7a55; }
+
+/* Streak card: gold foil, bigger radius, full-width pill button */
+.streak-card-hero {
+  border-radius: 30px;
+  border: 1px solid rgba(255, 240, 180, 0.75);
+  box-shadow: 0 18px 44px rgba(0, 0, 0, 0.5), 0 0 40px rgba(232, 201, 107, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.6);
+}
+[data-theme="light"] .streak-card-hero {
+  box-shadow: 0 18px 40px rgba(120, 85, 15, 0.38), 0 0 34px rgba(232, 201, 107, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.7);
+}
+.streak-hero-btn {
+  max-width: none;
+  height: 54px;
+  padding: 0 20px;
+  border-radius: 999px;
+  font-size: 1rem;
+  font-weight: 900;
+  color: #F6E3A0;
+  background: linear-gradient(180deg, #2e2208, #150f03);
+  box-shadow: 0 12px 26px rgba(42, 30, 5, 0.4), inset 0 1px 0 rgba(255, 233, 160, 0.25);
+}
+
+/* Day boxes: a scrolling strip that bleeds to the card edges */
+.streak-week {
+  display: flex;
+  justify-content: flex-start;
+  gap: 10px;
+  width: calc(100% + 40px);
+  max-width: none;
+  margin: 14px -20px 18px;
+  padding: 6px 20px;
+  overflow-x: auto;
+  scroll-snap-type: x proximity;
+  scrollbar-width: none;
+  -webkit-overflow-scrolling: touch;
+}
+.streak-week::-webkit-scrollbar { display: none; }
+.sd-box {
+  position: relative;
+  flex: none;
+  width: 96px;
+  height: 150px;
+  box-sizing: border-box;
+  border-radius: 24px;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 6px;
+  scroll-snap-align: start;
+  background: rgba(26, 19, 6, 0.88);
+  border: 1px solid rgba(201, 168, 76, 0.3);
+}
+.sd-name { font-size: 0.78rem; font-weight: 700; color: #BDB59F; max-width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding: 0 4px; }
+.sd-medal {
+  width: 46px; height: 46px;
+  box-sizing: border-box;
+  border-radius: 50%;
+  display: grid;
+  place-items: center;
+  border: 1.5px dashed rgba(232, 201, 107, 0.35);
+  color: #E8C96B;
+}
+.sd-num { font-family: var(--font-body); font-size: 1.6rem; font-weight: 900; line-height: 1; color: #F0EDE4; }
+.sd-cap {
+  max-width: calc(100% - 12px);
+  padding: 4px 10px;
+  border-radius: 999px;
+  font-size: 0.72rem;
+  font-weight: 700;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  color: #9a8a62;
+  background: rgba(255, 255, 255, 0.06);
+}
+.sd-lock { position: absolute; top: 10px; right: 10px; color: #9a8a62; display: flex; }
+.sd-box.is-read .sd-medal { border: 0; background: linear-gradient(180deg, #F1D786, #C9A84C); color: #1a1300; box-shadow: 0 6px 16px rgba(201, 168, 76, 0.4); }
+.sd-box.is-read .sd-cap { color: #E8C96B; background: rgba(201, 168, 76, 0.16); }
+.sd-box.is-frozen .sd-medal { border: 0; background: #1B3A4B; color: #63B3ED; }
+.sd-box.is-frozen .sd-cap { color: #63B3ED; background: rgba(99, 179, 237, 0.14); }
+.sd-box.is-missed { background: rgba(26, 19, 6, 0.62); border-color: rgba(201, 168, 76, 0.16); }
+.sd-box.is-missed .sd-num { color: #B9AE90; }
+.sd-box.is-future { background: rgba(26, 19, 6, 0.62); border-color: rgba(201, 168, 76, 0.16); }
+.sd-box.is-future .sd-num { color: #B9AE90; }
+.sd-box.is-today {
+  background: rgba(26, 19, 6, 0.94);
+  border: 2.5px solid #F6E3A0;
+  box-shadow: 0 0 22px rgba(232, 201, 107, 0.45);
+}
+.sd-box.is-today .sd-medal { border: 2px solid #E8C96B; background: rgba(201, 168, 76, 0.14); color: #F1D786; }
+.sd-box.is-today.is-read .sd-medal { border: 0; background: linear-gradient(180deg, #F1D786, #C9A84C); color: #1a1300; }
+.sd-box.is-today .sd-num { color: #fff; }
+.sd-box.is-today .sd-cap { color: #1a1300; font-weight: 900; background: linear-gradient(180deg, #F1D786, #C9A84C); }
