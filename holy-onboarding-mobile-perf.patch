diff --git a/frontend/styles.css b/frontend/styles.css
index 0e2ceff..410992d 100644
--- a/frontend/styles.css
+++ b/frontend/styles.css
@@ -12283,3 +12283,18 @@ h1, h2, h3, h4 { font-family: var(--font-body); font-weight: 700; letter-spacing
 #onboarding .topic-selected-tags::-webkit-scrollbar { display: none; }
 #onboarding .topic-tag-pill { flex-shrink: 0; }
 #onboarding .topics-chips-list { max-height: max(240px, calc(100vh - 505px)); max-height: max(240px, calc(100dvh - 505px)); }
+
+/* ═══ Onboarding performance pass (phones / touch WebViews) ═══
+   - Background orbs are already soft radial gradients: the extra blur(100px) on
+     400px layers + endless morph animation forced a huge re-raster every frame.
+   - The topic-list fade used mask-image, which repaints the whole scrolling list.
+   - Always-on logo glow animation removed on touch devices.
+   Desktop keeps the full effects. */
+@media (hover: none), (max-width: 480px) {
+  #onboarding .ob-bg-orb { filter: none; animation: none; will-change: auto; }
+  #onboarding .ob-logo-clean::after { animation: none; will-change: auto; opacity: 0.5; }
+  #onboarding .topics-chips-list { -webkit-mask-image: none; mask-image: none; padding-bottom: 6px; }
+  #onboarding .topic-chip { contain: layout paint; }
+  #onboarding .topic-chip.active { animation-duration: 0.2s; }
+  #onboarding .onboarding-step { animation-duration: 0.22s; }
+}
