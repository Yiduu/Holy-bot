diff --git a/frontend/styles.css b/frontend/styles.css
index d5242b0..fd036ab 100644
--- a/frontend/styles.css
+++ b/frontend/styles.css
@@ -4602,11 +4602,163 @@ textarea.form-control {
   color: var(--gold);
 }
 
+/* ─── Streak card: freeze badge ─────────────────────────────── */
+.streak-freeze-badge {
+  display: inline-flex;
+  align-items: center;
+  gap: 3px;
+  margin-left: 2px;
+  padding: 2px 7px 2px 6px;
+  border-radius: 999px;
+  background: rgba(96, 179, 224, 0.14);
+  color: #6BB8E0;
+  font-family: var(--font-body, inherit);
+  font-size: 0.68rem;
+  font-weight: 700;
+  letter-spacing: 0;
+  text-transform: none;
+  vertical-align: middle;
+}
+
+.streak-freeze-badge svg { display: block; flex-shrink: 0; }
+
+/* ─── Streak card: personal-best badge (replaces plain sub-label) ── */
+.streak-best-badge {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  color: var(--gold-light);
+  font-weight: 700;
+}
+
+.streak-best-badge svg { flex-shrink: 0; }
+
+/* ─── Streak card: weekly progress strip ────────────────────── */
+.streak-week {
+  display: flex;
+  justify-content: center;
+  gap: 10px;
+  margin: 2px 0 16px;
+}
+
+.streak-week-item {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 5px;
+}
+
+.streak-week-dot {
+  width: 26px;
+  height: 26px;
+  border-radius: 50%;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  border: 1.5px solid var(--border-dim);
+  color: transparent;
+  background: rgba(var(--bg-rgb), 0.4);
+  transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s var(--ease-spring);
+}
+
+.streak-week-dot.is-read {
+  background: linear-gradient(150deg, var(--gold-light), var(--gold));
+  border-color: transparent;
+  color: #1a1607;
+  box-shadow: 0 0 0 1px rgba(201, 168, 76, 0.3);
+}
+
+.streak-week-dot.is-frozen {
+  background: linear-gradient(150deg, #8FD1F0, #4E9FC7);
+  border-color: transparent;
+  color: #0c2430;
+  box-shadow: 0 0 0 1px rgba(78, 159, 199, 0.35);
+}
+
+.streak-week-dot.is-today {
+  transform: scale(1.08);
+  box-shadow: 0 0 0 2px var(--bg), 0 0 0 3.5px var(--gold);
+}
+
+.streak-week-label {
+  font-size: 0.62rem;
+  font-weight: 600;
+  color: var(--text3);
+  text-transform: uppercase;
+}
+
+/* ─── Streak card: reminder opt-in nudge ────────────────────── */
+.streak-reminder-nudge {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  width: 100%;
+  max-width: 280px;
+  margin-top: 10px;
+  padding: 9px 12px;
+  border-radius: 12px;
+  background: rgba(var(--bg-rgb), 0.5);
+  border: 1px dashed var(--border);
+  color: var(--text2);
+  font-size: 0.74rem;
+  line-height: 1.3;
+  text-align: left;
+}
+
+.streak-reminder-nudge svg {
+  flex-shrink: 0;
+  color: var(--gold-light);
+}
+
+.streak-reminder-nudge span {
+  flex: 1;
+}
+
+.streak-reminder-btn {
+  flex-shrink: 0;
+  border: none;
+  background: var(--gold-dim);
+  color: var(--gold-light);
+  font-size: 0.72rem;
+  font-weight: 700;
+  padding: 5px 10px;
+  border-radius: 999px;
+  cursor: pointer;
+  transition: background 0.15s ease, transform 0.15s ease;
+}
+
+.streak-reminder-btn:hover { background: var(--gold); color: #1a1607; }
+.streak-reminder-btn:active { transform: scale(0.94); }
+
+/* ─── Streak card: completed-for-today state ────────────────── */
+.streak-card.is-done-today {
+  border-color: rgba(91, 173, 122, 0.35);
+  box-shadow: 0 0 0 1px rgba(91, 173, 122, 0.12), var(--shadow-gold);
+}
+
+.streak-card.is-done-today .streak-hero-btn {
+  background: rgba(91, 173, 122, 0.14);
+  color: var(--success);
+  border: 1px solid rgba(91, 173, 122, 0.3);
+}
+
+/* ─── Streak card: milestone celebration pulse ──────────────── */
+.streak-card.streak-celebrate {
+  animation: streakCelebratePulse 1.2s var(--ease-premium);
+}
+
+@keyframes streakCelebratePulse {
+  0% { box-shadow: var(--shadow-gold); }
+  30% { box-shadow: 0 0 0 4px rgba(201, 168, 76, 0.22), 0 0 32px rgba(201, 168, 76, 0.4); }
+  100% { box-shadow: var(--shadow-gold); }
+}
+
 /* ─── Reduced motion: calm the new icon animations too ──────── */
 @media (prefers-reduced-motion: reduce) {
 
   .streak-flame,
-  .streak-glow {
+  .streak-glow,
+  .streak-card.streak-celebrate {
     animation: none !important;
   }
 }
