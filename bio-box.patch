+/* ─── Bio box (closed/premium display + edit toggle) ─────────── */
+.bio-box {
+  position: relative;
+  display: flex;
+  align-items: flex-start;
+  gap: 10px;
+  width: 100%;
+  padding: 14px 40px 14px 16px;
+  background: var(--bg3);
+  border: 1px solid var(--border-dim);
+  border-radius: var(--radius-sm);
+  cursor: pointer;
+  transition: border-color var(--transition), box-shadow var(--transition), transform 0.2s var(--ease-premium);
+}
+
+.bio-box:hover {
+  border-color: var(--border);
+  box-shadow: var(--shadow-gold);
+  transform: translateY(-1px);
+}
+
+.bio-box-text {
+  flex: 1;
+  min-width: 0;
+  font-size: 0.9rem;
+  line-height: 1.55;
+  color: var(--text);
+  white-space: pre-wrap;
+  word-break: break-word;
+}
+
+.bio-box-text.is-empty {
+  color: var(--text3);
+  font-style: italic;
+}
+
+.bio-edit-btn {
+  position: absolute;
+  top: 10px;
+  right: 10px;
+  width: 26px;
+  height: 26px;
+  border-radius: 50%;
+  background: var(--surface);
+  border: 1px solid var(--border-dim);
+  color: var(--text2);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  flex-shrink: 0;
+  transition: all var(--transition);
+}
+
+.bio-edit-btn:hover {
+  border-color: var(--border);
+  color: var(--gold);
+  background: var(--gold-dim);
+}
+
 /* ─── Toggle ────────────────────────────────────────────────── */
 .toggle-wrap {
   display: flex;
