From 0112befead19f8159620bcee194f5df1dd3b4391 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 18 Oct 2026 11:52:43 +0300
Subject: [PATCH] Admin conversations: premium list and chat viewer that
 mirrors the app chat

- Conversations list is now cards (avatars, last message, counts, unread)
- Chat viewer reuses the app's bubble, reply-quote, edited and date-divider
  styles: gold mentee bubbles, mentor bubbles, sender tags, seen ticks
- Replies show a quote of the original; tapping it jumps to and flashes the
  message. Older/deleted originals show a preview or "Original message
  unavailable", same as the app
- Edited, deleted and flagged markers, header stats, load-older, jump-to-latest
- API: admin messages endpoint now returns parent_id, parent_preview, read_at

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SGbABJtPPrCj97G2nSqD6w
---
 frontend/admin.css  | 297 ++++++++++++++++++++++++++++
 frontend/admin.html | 464 ++++++++++++++++++++++++--------------------
 routes/admin.js     |  23 +++
 3 files changed, 574 insertions(+), 210 deletions(-)

diff --git a/frontend/admin.css b/frontend/admin.css
index 472cd43..bf11401 100644
--- a/frontend/admin.css
+++ b/frontend/admin.css
@@ -579,3 +579,300 @@ code.slug, .audit-action { border-radius: 6px; }
 @media (prefers-reduced-motion: reduce) {
   .toast, .modal { animation: none !important; }
 }
+
+/* ============================================================
+   Conversations page + chat viewer
+   The bubbles below reuse the mini-app's own class names and
+   rules (styles.css: .message-bubble, .reply-quote, .msg-edited,
+   .chat-date-divider) so a conversation reads here exactly as it
+   does in the app. Mentee = "sent" (gold), mentor = "received".
+   ============================================================ */
+
+/* ─── Conversation list ──────────────────────────────────────── */
+.conv-list { display: flex; flex-direction: column; gap: 10px; }
+
+.conv-card {
+  position: relative;
+  overflow: hidden;
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  padding: 14px 16px;
+  background: var(--surface);
+  border: 1px solid var(--border-dim);
+  border-radius: var(--radius-card);
+  box-shadow: var(--inset-hi);
+  cursor: pointer;
+  transition: transform 0.2s var(--ease-premium), border-color 0.2s ease, box-shadow 0.2s ease;
+}
+.conv-card::before {
+  content: '';
+  position: absolute;
+  top: 0; left: 0; right: 0;
+  height: 2px;
+  background: linear-gradient(90deg, transparent, var(--gold), transparent);
+  opacity: 0;
+  transition: opacity 0.4s ease;
+}
+@media (hover: hover) {
+  .conv-card:hover { transform: translateY(-1px); border-color: var(--border); box-shadow: var(--shadow-md), var(--inset-hi); }
+  .conv-card:hover::before { opacity: 1; }
+}
+.conv-card:active { transform: scale(0.995); }
+
+.conv-avatars { display: flex; flex-shrink: 0; }
+.conv-av {
+  width: 42px;
+  height: 42px;
+  border-radius: 50%;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  font-weight: 900;
+  font-size: 0.95rem;
+  border: 2px solid var(--bg);
+  flex-shrink: 0;
+}
+.conv-av.mentor { background: linear-gradient(145deg, var(--gold-light), var(--gold) 60%, #A87C2A); color: var(--espresso); position: relative; z-index: 1; }
+.conv-av.mentee { background: rgba(91, 142, 255, 0.2); color: var(--accent); margin-left: -12px; }
+
+.conv-main { flex: 1; min-width: 0; }
+.conv-names { display: flex; align-items: center; gap: 7px; font-size: var(--fs-md); font-weight: 700; min-width: 0; }
+.conv-names .m { color: var(--gold); }
+.conv-names .u { color: var(--accent); }
+.conv-names .sep { color: var(--text3); font-weight: 400; }
+.conv-names span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.conv-preview { margin-top: 3px; font-size: var(--fs-sm); color: var(--text2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.conv-preview.none { color: var(--text3); font-style: italic; }
+
+.conv-side { display: flex; flex-direction: column; align-items: flex-end; gap: 7px; flex-shrink: 0; }
+.conv-time { font-size: var(--fs-xs); color: var(--text3); }
+.conv-chips { display: flex; gap: 6px; }
+
+@media (max-width: 480px) {
+  .conv-card { padding: 12px; gap: 10px; }
+  .conv-av { width: 36px; height: 36px; font-size: 0.85rem; }
+  .conv-av.mentee { margin-left: -10px; }
+}
+
+/* ─── Chat viewer modal ──────────────────────────────────────── */
+#conversationModal .modal.chat-modal {
+  max-width: 720px;
+  width: 100%;
+  height: min(88vh, 840px);
+  max-height: none;
+  padding: 0;
+  display: flex;
+  flex-direction: column;
+  overflow: hidden;
+}
+
+.chat-head {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: 14px 16px;
+  background: linear-gradient(180deg, var(--bg2), transparent);
+  border-bottom: 1px solid var(--border-dim);
+  flex-shrink: 0;
+}
+.chat-head .conv-av { width: 40px; height: 40px; border-color: var(--bg2); }
+.chat-head-main { flex: 1; min-width: 0; }
+.chat-head-title { display: flex; align-items: center; gap: 7px; font-size: var(--fs-base); font-weight: 700; min-width: 0; }
+.chat-head-title .m { color: var(--gold); }
+.chat-head-title .u { color: var(--accent); }
+.chat-head-title .sep { color: var(--text3); font-weight: 400; }
+.chat-head-title span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.chat-head-sub { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 5px; }
+.chat-close {
+  width: 34px; height: 34px;
+  border-radius: 12px;
+  background: var(--surface);
+  border: 1px solid var(--border-dim);
+  color: var(--text2);
+  display: flex; align-items: center; justify-content: center;
+  flex-shrink: 0;
+  transition: border-color 0.15s ease, color 0.15s ease;
+}
+.chat-close:hover { border-color: var(--gold); color: var(--gold); }
+.chat-close svg { width: 15px; height: 15px; stroke: currentColor; fill: none; stroke-width: 2; }
+
+.chat-stage {
+  position: relative;
+  flex: 1;
+  min-height: 0;
+  background:
+    radial-gradient(90% 60% at 50% 0%, rgba(201, 168, 76, 0.07), transparent 70%),
+    var(--bg);
+}
+.chat-scroll {
+  height: 100%;
+  overflow-y: auto;
+  overscroll-behavior: contain;
+  -webkit-overflow-scrolling: touch;
+  padding: 14px 16px 18px;
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+
+.chat-older { display: flex; justify-content: center; margin-bottom: 6px; }
+.chat-jump {
+  position: absolute;
+  right: 16px;
+  bottom: 16px;
+  width: 38px; height: 38px;
+  border-radius: 50%;
+  background: var(--bg2);
+  border: 1px solid var(--border);
+  color: var(--gold);
+  box-shadow: var(--shadow-md);
+  display: none;
+  align-items: center; justify-content: center;
+}
+.chat-jump.show { display: flex; }
+.chat-jump svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 2.4; }
+
+/* ─── Bubbles (mirrors styles.css) ───────────────────────────── */
+.chat-scroll .message-thread { display: flex; flex-direction: column; width: 100%; gap: 4px; }
+.chat-scroll .message-thread.thread-sent { align-items: flex-end; }
+.chat-scroll .message-thread.thread-received { align-items: flex-start; }
+
+.chat-sender-tag {
+  font-size: var(--fs-2xs);
+  font-weight: 700;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  margin: 8px 6px 0;
+}
+.chat-sender-tag.mentor { color: var(--gold); }
+.chat-sender-tag.mentee { color: var(--accent); }
+
+.message-bubble {
+  max-width: 80%;
+  padding: 10px 14px 8px;
+  border-radius: 20px;
+  font-size: var(--fs-md);
+  line-height: 1.55;
+  word-break: break-word;
+  position: relative;
+  box-shadow: 0 1px 6px rgba(0, 0, 0, 0.18);
+  transition: box-shadow 0.35s ease;
+}
+.message-bubble.sent {
+  background: linear-gradient(145deg, var(--gold) 0%, #a87a28 100%);
+  color: #1a1200;
+  border-radius: 20px 20px 5px 20px;
+}
+.message-bubble.received {
+  background: var(--bg3);
+  border: 1px solid var(--border-dim);
+  color: var(--text);
+  border-radius: 20px 20px 20px 5px;
+}
+.message-bubble.msg-flash { box-shadow: 0 0 0 3px rgba(201, 168, 76, 0.65), 0 1px 6px rgba(0, 0, 0, 0.18); }
+.message-bubble.is-flagged { outline: 1px solid rgba(224, 92, 92, 0.55); outline-offset: 2px; }
+
+.message-text { font-size: var(--fs-md); line-height: 1.55; }
+.msg-content { white-space: pre-wrap; }
+.message-caption { margin-top: 6px; }
+.msg-edited { font-size: var(--fs-2xs); font-style: italic; opacity: 0.6; margin-left: 5px; vertical-align: middle; }
+
+.message-footer { display: flex; align-items: center; justify-content: flex-end; gap: 7px; margin-top: 5px; min-height: 18px; }
+.message-time { font-size: var(--fs-2xs); color: var(--text3); letter-spacing: 0.01em; }
+.message-bubble.sent .message-time { color: rgba(26, 18, 0, 0.55); }
+
+.msg-status { font-size: var(--fs-xs); line-height: 1; letter-spacing: -2px; }
+.msg-status.unread { color: var(--text3); opacity: 0.6; }
+.msg-status.read { color: #3897f0; }
+.message-bubble.sent .msg-status.unread { color: rgba(26, 18, 0, 0.5); }
+.message-bubble.sent .msg-status.read { color: #0b4a8f; }
+
+.msg-flag {
+  font-size: var(--fs-2xs);
+  font-weight: 700;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+  color: var(--danger);
+  background: rgba(224, 92, 92, 0.14);
+  padding: 1px 7px;
+  border-radius: 99px;
+}
+.message-bubble.sent .msg-flag { background: rgba(120, 20, 20, 0.18); color: #6b1111; }
+
+.msg-deleted { display: flex; align-items: center; gap: 7px; font-style: italic; opacity: 0.7; font-size: var(--fs-sm); }
+.msg-deleted svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 2; flex-shrink: 0; }
+.message-bubble.is-deleted { box-shadow: none; }
+.message-bubble.is-deleted.received { background: transparent; border-style: dashed; }
+.message-bubble.is-deleted.sent { background: rgba(201, 168, 76, 0.16); color: var(--text2); border: 1px dashed var(--border); }
+
+/* ─── Reply quote (mirrors styles.css) ───────────────────────── */
+.reply-quote {
+  display: flex;
+  flex-direction: column;
+  gap: 1px;
+  min-width: 0;
+  max-width: 100%;
+  margin: 0 0 6px;
+  padding: 5px 10px 5px 9px;
+  border-left: 3px solid var(--gold);
+  border-radius: 6px 10px 10px 6px;
+  background: rgba(201, 168, 76, 0.12);
+  font-size: var(--fs-xs);
+  line-height: 1.35;
+  text-align: left;
+  cursor: pointer;
+  overflow: hidden;
+}
+.reply-quote:active { filter: brightness(0.92); }
+.reply-quote-name { font-weight: 700; color: var(--gold); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.reply-quote-name.mentee { color: var(--accent); }
+.reply-quote-text { display: flex; align-items: center; gap: 5px; color: var(--text2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.reply-quote-text svg { width: 12px; height: 12px; stroke: currentColor; fill: none; stroke-width: 2; flex-shrink: 0; }
+.message-bubble.sent .reply-quote { background: rgba(26, 18, 0, 0.14); border-left-color: rgba(26, 18, 0, 0.6); }
+.message-bubble.sent .reply-quote-name { color: rgba(26, 18, 0, 0.85); }
+.message-bubble.sent .reply-quote-text { color: rgba(26, 18, 0, 0.7); }
+.reply-quote-missing { cursor: default; border-left-color: var(--text3); background: rgba(128, 128, 128, 0.12); }
+.reply-quote-missing .reply-quote-text { font-style: italic; color: var(--text3); }
+.message-bubble.sent .reply-quote-missing { border-left-color: rgba(26, 18, 0, 0.35); }
+.message-bubble.sent .reply-quote-missing .reply-quote-text { color: rgba(26, 18, 0, 0.55); }
+
+/* ─── Date divider (mirrors styles.css) ──────────────────────── */
+.chat-date-divider { display: flex; align-items: center; justify-content: center; margin: 14px 0 8px; position: relative; }
+.chat-date-divider::before { content: ""; position: absolute; left: 0; right: 0; height: 1px; background: var(--border-dim); z-index: 1; }
+.chat-date-divider span {
+  position: relative;
+  z-index: 2;
+  background: var(--bg);
+  padding: 4px 12px;
+  font-size: var(--fs-xs);
+  font-weight: 600;
+  color: var(--text3);
+  border-radius: 12px;
+  border: 1px solid var(--border-dim);
+}
+
+/* ─── Attachments inside gold (mentee) bubbles ───────────────── */
+.message-bubble .admin-msg-voice-label,
+.message-bubble .admin-msg-voice-time,
+.message-bubble .admin-msg-file-size { color: inherit; opacity: 0.65; }
+.message-bubble.sent .admin-msg-voice-play,
+.message-bubble.sent .admin-msg-file-btn { background: rgba(26, 18, 0, 0.16); border-color: rgba(26, 18, 0, 0.3); color: #1a1200; }
+.message-bubble.sent .admin-msg-voice-progress { background: rgba(26, 18, 0, 0.22); }
+.message-bubble.sent .admin-msg-voice-progress-fill,
+.message-bubble.sent .admin-msg-voice-progress-handle { background: #1a1200; }
+.message-bubble .admin-msg-photo img { border-radius: 12px; }
+
+@media (max-width: 640px) {
+  .chat-head { gap: 10px; padding: 12px; }
+  .chat-head .conv-av { width: 32px; height: 32px; font-size: 0.8rem; }
+  .chat-head .conv-av.mentee { margin-left: -9px; }
+  .chat-head-title { font-size: var(--fs-md); gap: 5px; }
+  .chat-head-sub { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-right: -12px; padding-right: 12px; }
+  .chat-head-sub::-webkit-scrollbar { display: none; }
+  .chat-head-sub .chip { flex-shrink: 0; white-space: nowrap; }
+  #conversationModal .modal.chat-modal { height: 92vh; border-radius: var(--radius) var(--radius) 0 0; padding: 0; }
+  #conversationModal .modal.chat-modal::before { display: none; }
+  .chat-scroll { padding: 12px 12px 16px; }
+  .message-bubble { max-width: 88%; }
+}
