diff --git a/migrations/20261010_notification_preferences.sql b/migrations/20261010_notification_preferences.sql
new file mode 100644
index 0000000..d6ad618
--- /dev/null
+++ b/migrations/20261010_notification_preferences.sql
@@ -0,0 +1,29 @@
+BEGIN;
+
+-- Notification preferences v2.
+--
+-- notify_messages / notify_sessions already existed but were never enforced.
+-- This adds the missing categories plus privacy + quiet-hours controls.
+--
+--   notify_goals          goal assigned / due / missed / daily task reminders
+--   notify_nudges         "we miss you" inactivity reminders from the scheduler
+--   message_preview       false => Telegram shows "New message" without the text
+--                         (useful on a lock screen for a sensitive counseling app)
+--   quiet_hours_*         inside the window notifications are delivered SILENTLY
+--                         (no sound / vibration); they are never dropped.
+--                         Hours are 0-23 in user_settings.timezone.
+ALTER TABLE user_settings
+  ADD COLUMN IF NOT EXISTS notify_streak_reminder BOOLEAN NOT NULL DEFAULT true,
+  ADD COLUMN IF NOT EXISTS notify_goals          BOOLEAN NOT NULL DEFAULT true,
+  ADD COLUMN IF NOT EXISTS notify_nudges         BOOLEAN NOT NULL DEFAULT true,
+  ADD COLUMN IF NOT EXISTS message_preview       BOOLEAN NOT NULL DEFAULT true,
+  ADD COLUMN IF NOT EXISTS quiet_hours_enabled   BOOLEAN NOT NULL DEFAULT false,
+  ADD COLUMN IF NOT EXISTS quiet_start           SMALLINT NOT NULL DEFAULT 22,
+  ADD COLUMN IF NOT EXISTS quiet_end             SMALLINT NOT NULL DEFAULT 7;
+
+ALTER TABLE user_settings
+  DROP CONSTRAINT IF EXISTS user_settings_quiet_hours_range,
+  ADD CONSTRAINT user_settings_quiet_hours_range
+    CHECK (quiet_start BETWEEN 0 AND 23 AND quiet_end BETWEEN 0 AND 23);
+
+COMMIT;
