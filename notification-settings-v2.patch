diff --git a/utils/notificationPrefs.js b/utils/notificationPrefs.js
new file mode 100644
index 0000000..21a512c
--- /dev/null
+++ b/utils/notificationPrefs.js
@@ -0,0 +1,147 @@
+// Single source of truth for per-user notification preferences.
+//
+// Before this module, `notify_messages` and `notify_sessions` were stored and
+// shown in the UI but never checked anywhere, so those toggles did nothing.
+// Every Telegram notification now goes through `gate()`.
+//
+//   const g = await gate(supabase, chatId, 'messages');
+//   if (!g.allowed) return;                       // user turned this category off
+//   await safeSend(chatId, text, { ...g.extra });  // extra.disable_notification during quiet hours
+//
+// Design rules:
+//  * Quiet hours never DROP a notification, they deliver it silently (no
+//    sound / vibration). Someone in a counseling conversation must not lose a
+//    message because it arrived at 11pm.
+//  * Missing settings row / missing column (migration not yet run) => defaults,
+//    so a user who never opened Settings keeps getting what they always got.
+
+const DEFAULT_TZ = 'Africa/Addis_Ababa';
+
+// category -> column that stores its on/off flag
+const CATEGORY_COLUMN = {
+  messages: 'notify_messages',
+  sessions: 'notify_sessions',
+  verse: 'notify_daily_verse',
+  streak: 'notify_streak_reminder',
+  goals: 'notify_goals',
+  nudges: 'notify_nudges',
+};
+
+const DEFAULTS = Object.freeze({
+  notify_messages: true,
+  notify_sessions: true,
+  notify_daily_verse: true,
+  notify_streak_reminder: true,
+  notify_goals: true,
+  notify_nudges: true,
+  message_preview: true,
+  quiet_hours_enabled: false,
+  quiet_start: 22,
+  quiet_end: 7,
+  verse_time: 7,
+  timezone: DEFAULT_TZ,
+});
+
+// Columns the settings API may write (booleans / hours / timezone).
+const BOOLEAN_FIELDS = [
+  'notify_messages', 'notify_sessions', 'notify_daily_verse', 'notify_streak_reminder',
+  'notify_goals', 'notify_nudges', 'message_preview', 'quiet_hours_enabled',
+];
+const HOUR_FIELDS = ['quiet_start', 'quiet_end'];
+
+function isValidTimezone(tz) {
+  if (typeof tz !== 'string' || !tz || tz.length > 64) return false;
+  try { new Intl.DateTimeFormat('en-US', { timeZone: tz }); return true; } catch { return false; }
+}
+
+// Merge a stored row over the defaults. `null` / `undefined` => default.
+function normalize(row) {
+  const out = { ...DEFAULTS };
+  if (!row) return out;
+  for (const k of Object.keys(DEFAULTS)) {
+    if (row[k] !== undefined && row[k] !== null) out[k] = row[k];
+  }
+  // 'UTC' is the column default and means "never chosen" — fall back to Ethiopia.
+  if (!isValidTimezone(out.timezone) || out.timezone === 'UTC') out.timezone = DEFAULT_TZ;
+  return out;
+}
+
+// Hour (0-23) of `date` in `tz`.
+function hourInZone(date, tz) {
+  const h = new Intl.DateTimeFormat('en-US', { timeZone: tz, hour: 'numeric', hourCycle: 'h23' })
+    .formatToParts(date).find(p => p.type === 'hour');
+  return Number(h?.value ?? 0) % 24;
+}
+
+// True when `date` falls inside the user's quiet window. Handles windows that
+// cross midnight (22 -> 7). start === end means "off".
+function isQuietNow(prefs, date = new Date()) {
+  if (!prefs.quiet_hours_enabled) return false;
+  const start = Number(prefs.quiet_start), end = Number(prefs.quiet_end);
+  if (start === end) return false;
+  const h = hourInZone(date, prefs.timezone);
+  return start < end ? (h >= start && h < end) : (h >= start || h < end);
+}
+
+// Validate + coerce a PATCH body down to the notification columns we accept.
+// Returns { updates, error }.
+function sanitizeUpdates(body = {}) {
+  const updates = {};
+  for (const k of BOOLEAN_FIELDS) {
+    if (body[k] === undefined) continue;
+    if (typeof body[k] !== 'boolean') return { error: `${k} must be true or false` };
+    updates[k] = body[k];
+  }
+  for (const k of HOUR_FIELDS) {
+    if (body[k] === undefined) continue;
+    const n = body[k];
+    if (!Number.isInteger(n) || n < 0 || n > 23) return { error: `${k} must be a whole hour between 0 and 23` };
+    updates[k] = n;
+  }
+  if (body.timezone !== undefined) {
+    if (!isValidTimezone(body.timezone)) return { error: 'Unknown timezone' };
+    updates.timezone = body.timezone;
+  }
+  return { updates };
+}
+
+// ── Small TTL cache: a chat can fire several notifications per second and each
+// one used to cost a DB round-trip. 30s staleness is fine; saving settings
+// invalidates immediately.
+const CACHE_TTL_MS = 30 * 1000;
+const cache = new Map(); // String(id) -> { at, prefs }
+
+function invalidate(id) { cache.delete(String(id)); }
+
+async function getPrefs(supabase, id) {
+  const key = String(id);
+  const hit = cache.get(key);
+  if (hit && Date.now() - hit.at < CACHE_TTL_MS) return hit.prefs;
+  let prefs;
+  try {
+    const { data, error } = await supabase.from('user_settings').select('*').eq('telegram_id', id).maybeSingle();
+    prefs = normalize(error ? null : data);
+  } catch {
+    prefs = normalize(null); // never let a settings lookup block a notification
+  }
+  cache.set(key, { at: Date.now(), prefs });
+  if (cache.size > 5000) cache.delete(cache.keys().next().value); // crude bound
+  return prefs;
+}
+
+// The one call every notifier makes.
+//   -> { allowed, silent, prefs, extra }
+async function gate(supabase, id, category, { now = new Date(), force = false } = {}) {
+  const col = CATEGORY_COLUMN[category];
+  if (!col) throw new Error(`Unknown notification category: ${category}`);
+  const prefs = await getPrefs(supabase, id);
+  const allowed = force || prefs[col] !== false;
+  const silent = allowed && isQuietNow(prefs, now);
+  return { allowed, silent, prefs, extra: silent ? { disable_notification: true } : {} };
+}
+
+module.exports = {
+  CATEGORY_COLUMN, DEFAULTS, DEFAULT_TZ, BOOLEAN_FIELDS, HOUR_FIELDS,
+  normalize, isValidTimezone, isQuietNow, hourInZone, sanitizeUpdates,
+  getPrefs, invalidate, gate,
+};
