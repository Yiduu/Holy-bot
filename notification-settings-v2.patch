diff --git a/tests/notification-prefs.test.js b/tests/notification-prefs.test.js
new file mode 100644
index 0000000..a163bf7
--- /dev/null
+++ b/tests/notification-prefs.test.js
@@ -0,0 +1,111 @@
+// Run: node tests/notification-prefs.test.js   (no network, no Supabase needed)
+// Covers utils/notificationPrefs.js: defaults, quiet hours (incl. across
+// midnight + time zones), the gate every notifier uses, and PATCH validation.
+const assert = require('assert');
+const P = require('../utils/notificationPrefs');
+const ok = n => console.log('  ✓', n);
+
+// ── normalize: missing row / null columns fall back to defaults ───────────────
+{
+  const d = P.normalize(null);
+  assert.strictEqual(d.notify_messages, true);
+  assert.strictEqual(d.message_preview, true);
+  assert.strictEqual(d.quiet_hours_enabled, false);
+  assert.strictEqual(d.timezone, 'Africa/Addis_Ababa');
+  const partial = P.normalize({ notify_messages: false, notify_goals: null, timezone: 'UTC' });
+  assert.strictEqual(partial.notify_messages, false);
+  assert.strictEqual(partial.notify_goals, true, 'null column => default');
+  assert.strictEqual(partial.timezone, 'Africa/Addis_Ababa', "column default 'UTC' means never chosen");
+  ok('normalize: defaults for missing row, null columns and untouched timezone');
+}
+
+// ── quiet hours ───────────────────────────────────────────────────────────────
+{
+  const base = { quiet_hours_enabled: true, quiet_start: 22, quiet_end: 7, timezone: 'Africa/Addis_Ababa' };
+  // Addis is UTC+3: 20:00Z = 23:00 local, 05:00Z = 08:00 local
+  assert.strictEqual(P.isQuietNow(base, new Date('2026-10-09T20:00:00Z')), true, '23:00 local is quiet');
+  assert.strictEqual(P.isQuietNow(base, new Date('2026-10-09T02:00:00Z')), true, '05:00 local is quiet (crosses midnight)');
+  assert.strictEqual(P.isQuietNow(base, new Date('2026-10-09T05:00:00Z')), false, '08:00 local is not quiet');
+  assert.strictEqual(P.isQuietNow(base, new Date('2026-10-09T04:00:00Z')), false, '07:00 local: end hour is exclusive');
+  assert.strictEqual(P.isQuietNow(base, new Date('2026-10-09T19:00:00Z')), true, '22:00 local: start hour is inclusive');
+  assert.strictEqual(P.isQuietNow({ ...base, quiet_hours_enabled: false }, new Date('2026-10-09T20:00:00Z')), false);
+  assert.strictEqual(P.isQuietNow({ ...base, quiet_start: 8, quiet_end: 8 }, new Date('2026-10-09T05:00:00Z')), false, 'start == end means off');
+  // same-day window, other time zone
+  const ny = { quiet_hours_enabled: true, quiet_start: 13, quiet_end: 15, timezone: 'America/New_York' };
+  assert.strictEqual(P.isQuietNow(ny, new Date('2026-10-09T18:30:00Z')), true, '14:30 New York (EDT)');
+  assert.strictEqual(P.isQuietNow(ny, new Date('2026-10-09T20:00:00Z')), false, '16:00 New York');
+  ok('isQuietNow: overnight window, boundaries, disabled, start==end, other zones');
+}
+
+// ── gate ──────────────────────────────────────────────────────────────────────
+function fakeSupabase(rows, counter = { n: 0 }) {
+  return {
+    counter,
+    from() {
+      const q = { select() { return q; }, eq() { return q; },
+        maybeSingle: async () => { counter.n++; return { data: rows.shift ? rows[0] : rows, error: null }; } };
+      return q;
+    },
+  };
+}
+(async () => {
+  {
+    const sb = fakeSupabase({ notify_messages: false });
+    const g = await P.gate(sb, 1001, 'messages');
+    assert.strictEqual(g.allowed, false);
+    P.invalidate(1001);
+    const g2 = await P.gate(fakeSupabase({ notify_messages: false }), 1001, 'messages', { force: true });
+    assert.strictEqual(g2.allowed, true, 'force overrides a muted category');
+    ok('gate: muted category blocks the send (and force bypasses it)');
+  }
+  {
+    P.invalidate(1002);
+    const sb = fakeSupabase({ quiet_hours_enabled: true, quiet_start: 22, quiet_end: 7, timezone: 'Africa/Addis_Ababa' });
+    const g = await P.gate(sb, 1002, 'sessions', { now: new Date('2026-10-09T20:00:00Z') });
+    assert.strictEqual(g.allowed, true, 'quiet hours never drop a notification');
+    assert.strictEqual(g.silent, true);
+    assert.deepStrictEqual(g.extra, { disable_notification: true });
+    const day = await P.gate(sb, 1002, 'sessions', { now: new Date('2026-10-09T09:00:00Z') });
+    assert.deepStrictEqual(day.extra, {}, 'daytime sends normally');
+    ok('gate: quiet hours deliver silently, daytime unchanged');
+  }
+  {
+    P.invalidate(1003);
+    const sb = fakeSupabase(null);
+    const g = await P.gate(sb, 1003, 'goals');
+    assert.strictEqual(g.allowed, true, 'no settings row => defaults (on)');
+    assert.strictEqual(g.prefs.message_preview, true);
+    ok('gate: user with no settings row keeps getting notifications');
+  }
+  {
+    P.invalidate(1004);
+    const sb = fakeSupabase({});
+    await P.gate(sb, 1004, 'verse'); await P.gate(sb, 1004, 'streak'); await P.gate(sb, 1004, 'nudges');
+    assert.strictEqual(sb.counter.n, 1, 'three notifications, one DB read');
+    P.invalidate(1004);
+    await P.gate(sb, 1004, 'verse');
+    assert.strictEqual(sb.counter.n, 2, 'invalidate forces a fresh read after settings change');
+    ok('getPrefs: cached, and invalidated on save');
+  }
+  {
+    const failing = { from() { throw new Error('db down'); } };
+    P.invalidate(1005);
+    const g = await P.gate(failing, 1005, 'messages');
+    assert.strictEqual(g.allowed, true, 'a failed settings lookup must not swallow a notification');
+    ok('gate: DB failure fails open');
+  }
+  assert.rejects(() => P.gate(fakeSupabase({}), 1, 'bogus'), /Unknown notification category/);
+  ok('gate: unknown category is a programming error');
+
+  // ── sanitizeUpdates ─────────────────────────────────────────────────────────
+  {
+    const good = P.sanitizeUpdates({ notify_goals: false, message_preview: false, quiet_hours_enabled: true, quiet_start: 23, quiet_end: 6, timezone: 'Africa/Addis_Ababa', display_name: 'ignored' });
+    assert.deepStrictEqual(good.updates, { notify_goals: false, message_preview: false, quiet_hours_enabled: true, quiet_start: 23, quiet_end: 6, timezone: 'Africa/Addis_Ababa' });
+    for (const bad of [{ notify_goals: 'yes' }, { quiet_start: 24 }, { quiet_end: -1 }, { quiet_start: null }, { quiet_start: '5' }, { quiet_start: 1.5 }, { timezone: 'Mars/Olympus' }]) {
+      assert.ok(P.sanitizeUpdates(bad).error, `rejects ${JSON.stringify(bad)}`);
+    }
+    assert.deepStrictEqual(P.sanitizeUpdates({}).updates, {});
+    ok('sanitizeUpdates: accepts valid prefs, rejects bad types / hours / timezones, ignores unrelated keys');
+  }
+  console.log('notification-prefs: all passed');
+})().catch(e => { console.error(e); process.exit(1); });
