+
+
+/* ═══ Notifications + Mentor Profile: page-style sheets ═══════════════════
+   Same look as the Profile / Mentors pages (gold glow, 26px gradient cards,
+   gold icon tiles, pill buttons + pill segmented control).
+   Layout = fixed header + scrolling middle + fixed footer, so the keyboard can
+   never cover the field you are typing in or the Save button.
+   Performance: no backdrop blur on the overlay, the switch animates only
+   transform/background, the old 20-layer "neo" toggle is not used here. ═══ */
+.ps-overlay {
+  backdrop-filter: none;
+  -webkit-backdrop-filter: none;
+  background: rgba(0, 0, 0, 0.62);
+  /* Where the keyboard overlays the page instead of resizing it (iOS Safari),
+     lift the sheet by the covered amount (--kb-inset is set in app.js). */
+  padding-bottom: var(--kb-inset, 0px);
+}
+.modal-sheet.page-sheet {
+  display: flex;
+  flex-direction: column;
+  height: min(92vh, calc(var(--app-height) - var(--kb-inset, 0px) - 12px));
+  max-height: none;
+  padding: 0;
+  overflow: hidden;
+  border: 1px solid var(--border-dim);
+  border-bottom: 0;
+  border-radius: 30px 30px 0 0;
+  background:
+    radial-gradient(120% 360px at 50% 0%, rgba(201, 168, 76, 0.24) 0%, rgba(168, 124, 42, 0.09) 45%, transparent 78%) no-repeat,
+    var(--bg);
+}
+[data-theme="light"] .modal-sheet.page-sheet {
+  background:
+    radial-gradient(120% 360px at 50% 0%, rgba(201, 168, 76, 0.30) 0%, rgba(201, 168, 76, 0.09) 45%, transparent 78%) no-repeat,
+    var(--bg);
+}
+.ps-head { flex: none; display: flex; align-items: center; gap: 12px; padding: 18px 16px 6px; }
+.ps-back {
+  width: 44px; height: 44px; flex: none;
+  display: flex; align-items: center; justify-content: center;
+  border-radius: 50%;
+  border: 1px solid rgba(255, 255, 255, 0.10);
+  background: rgba(255, 255, 255, 0.06);
+  color: var(--text);
+  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.06);
+}
+.ps-back:active { transform: scale(0.94); }
+.ps-title { margin: 0; font-family: var(--font-display); font-size: var(--fs-xl); letter-spacing: 0.02em; color: var(--text); }
+.ps-sub { flex: none; margin: 6px 22px 12px; font-size: var(--fs-sm); line-height: 1.5; color: var(--text2); }
+.ps-body {
+  flex: 1; min-height: 0;
+  display: flex; flex-direction: column; gap: 12px;
+  padding: 6px 16px 20px;
+  overflow-y: auto;
+  overscroll-behavior: contain;
+  -webkit-overflow-scrolling: touch;
+  scroll-padding-bottom: 24px;
+}
+.ps-foot {
+  flex: none;
+  padding: 12px 16px calc(14px + var(--nav-h) + var(--safe-bottom));   /* clears the bottom nav */
+  background: var(--bg);
+  border-top: 1px solid var(--border-dim);
+}
+/* Keyboard open: the nav is hidden by the keyboard logic, so don't leave a gap. */
+body.kb-open:has(.ps-overlay.open) .bottom-nav { display: none; }
+body.kb-open .ps-foot { padding-bottom: calc(12px + var(--safe-bottom)); }
+
+.ps-card {
+  flex: none;
+  padding: 16px 18px;
+  border: 1px solid rgba(255, 255, 255, 0.07);
+  border-radius: 26px;
+  background: linear-gradient(160deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.015)), #111319;
+  box-shadow: 0 10px 26px rgba(0, 0, 0, 0.32), inset 0 1px 0 rgba(255, 255, 255, 0.05);
+}
+.ps-card.ps-gold {
+  border-color: rgba(201, 168, 76, 0.35);
+  background: radial-gradient(120% 140% at 0% 0%, rgba(201, 168, 76, 0.22) 0%, rgba(201, 168, 76, 0.06) 55%, transparent 100%), #17140c;
+  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.38), 0 0 26px rgba(201, 168, 76, 0.12), inset 0 1px 0 rgba(255, 233, 160, 0.12);
+}
+[data-theme="light"] .ps-card { background: linear-gradient(160deg, #fff, #f6f3ea); border-color: rgba(150, 120, 40, 0.2); box-shadow: 0 8px 20px rgba(30, 25, 15, 0.12), inset 0 1px 0 #fff; }
+[data-theme="light"] .ps-card.ps-gold { background: radial-gradient(120% 140% at 0% 0%, rgba(201, 168, 76, 0.28), rgba(201, 168, 76, 0.08) 60%, #fffaf0); border-color: rgba(150, 120, 40, 0.35); }
+[data-theme="light"] .ps-back { background: rgba(255, 255, 255, 0.85); border-color: rgba(150, 120, 40, 0.28); box-shadow: 0 6px 16px rgba(30, 25, 15, 0.12); }
+
+.ps-row { display: flex; align-items: center; gap: 16px; min-height: 74px; padding: 14px 14px 14px 18px; }
+.ps-row--tight { justify-content: space-between; min-height: 0; padding: 12px 14px 12px 18px; }
+.ps-row-text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
+.ps-row-title { font-size: var(--fs-base); font-weight: 700; color: var(--text); }
+.ps-row-sub { font-size: var(--fs-xs); color: var(--text2); }
+.ps-tile {
+  width: 48px; height: 48px; flex: none;
+  display: flex; align-items: center; justify-content: center;
+  border-radius: 16px;
+  background: rgba(201, 168, 76, 0.13);
+  color: var(--gold-light);
+  box-shadow: inset 0 0 0 1px rgba(201, 168, 76, 0.22);
+}
+.ps-gold .ps-tile { background: radial-gradient(circle at 30% 25%, #f1d786, #c9a84c 70%); color: #2a1e05; box-shadow: 0 6px 16px rgba(201, 168, 76, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.5); }
+[data-theme="light"] .ps-tile { background: rgba(201, 168, 76, 0.16); color: #7A5812; box-shadow: inset 0 0 0 1px rgba(150, 120, 40, 0.25); }
+[data-theme="light"] .ps-gold .ps-tile { color: #2a1e05; }
+.ps-label { display: block; margin-bottom: 10px; font-size: var(--fs-xs); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gold-light); }
+[data-theme="light"] .ps-label { color: #7A5812; }
+
+/* fields: 16px stops iOS zooming in on focus; no scale-on-focus (it made the card jump) */
+.ps-card .input, .ps-card .form-control { font-size: 16px; line-height: 1.45; }
+.ps-card .input:focus { transform: none; }
+.ps-card textarea.form-control { resize: none; }
+.ps-card .bio-box:hover { transform: none; }
+
+/* pill segmented control (same as Browse | Saved) */
+.ps-seg { display: flex; gap: 4px; padding: 5px; border-radius: 999px; background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08); box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.25); }
+.ps-seg-btn { flex: 1; min-width: 0; height: 40px; padding: 0 8px; border-radius: 999px; font-size: var(--fs-md); font-weight: 600; color: var(--text2); white-space: nowrap; transition: background 0.2s, color 0.2s; }
+.ps-seg-btn.active { color: #1a1300; background: linear-gradient(180deg, #EBCD72, #C9A84C); box-shadow: 0 8px 20px rgba(201, 168, 76, 0.38), inset 0 1px 0 rgba(255, 255, 255, 0.4); }
+[data-theme="light"] .ps-seg { background: rgba(255, 255, 255, 0.7); border-color: rgba(150, 120, 40, 0.2); box-shadow: inset 0 2px 6px rgba(30, 25, 15, 0.08); }
+
+/* stepper */
+.ps-stepper { display: flex; align-items: center; gap: 10px; }
+.ps-step { width: 44px; height: 44px; border-radius: 50%; font-size: 22px; font-weight: 700; line-height: 1; color: var(--text); border: 1px solid rgba(255, 255, 255, 0.10); background: rgba(255, 255, 255, 0.06); }
+.ps-step:active { transform: scale(0.94); }
+[data-theme="light"] .ps-step { background: rgba(255, 255, 255, 0.85); border-color: rgba(150, 120, 40, 0.28); }
+.ps-card .ps-num { width: 48px; padding: 0; text-align: center; font-size: 18px; font-weight: 700; background: transparent; box-shadow: none; -moz-appearance: textfield; appearance: textfield; }
+.ps-num::-webkit-outer-spin-button, .ps-num::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
+
+/* switch: transform/background only */
+.ps-switch { position: relative; flex: none; }
+.ps-switch-input { position: absolute; opacity: 0; width: 0; height: 0; }
+.ps-switch-track { position: relative; display: block; width: 52px; height: 30px; box-sizing: border-box; border-radius: 999px; background: var(--bg3); border: 1px solid var(--border-dim); transition: background 0.2s; cursor: pointer; }
+.ps-switch-track::before { content: ''; position: absolute; inset: -9px -4px; }      /* 48px touch target */
+.ps-switch-knob { position: absolute; top: 2px; left: 2px; width: 24px; height: 24px; border-radius: 50%; background: #fff; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4); transition: transform 0.2s var(--ease-premium); will-change: transform; }
+.ps-switch-input:checked + .ps-switch-track { background: var(--gold); border-color: var(--gold); }
+.ps-switch-input:checked + .ps-switch-track .ps-switch-knob { transform: translateX(22px); }
+.ps-switch-input:focus-visible + .ps-switch-track { outline: 2px solid var(--gold-light); outline-offset: 2px; }
+
+/* topics */
+.ps-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
+.ps-tag { display: inline-flex; align-items: center; padding: 6px 12px; border-radius: 20px; background: var(--gold-dim); border: 1px solid var(--gold); color: var(--gold-light); font-size: var(--fs-xs); font-weight: 700; }
+.ps-empty { font-size: var(--fs-sm); color: var(--text3); }
+[data-theme="light"] .ps-tag { color: #7A5812; }
+.ps-card .btn-outline { gap: 8px; }
+
+@media (prefers-reduced-motion: reduce) { .ps-switch-knob, .ps-switch-track, .ps-seg-btn { transition: none; } }
