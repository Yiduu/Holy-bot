--- a/frontend/styles.css
+++ b/frontend/styles.css
@@ -13444,3 +13444,145 @@ h1, h2, h3, h4 { font-family: var(--font-body); font-weight: 700; letter-spacing
 [data-theme="light"] .journal-icon-btn { background: #fff; border-color: rgba(150, 120, 40, 0.25); }
 [data-theme="light"] .journal-icon-btn.danger { background: rgba(224, 92, 92, 0.08); border-color: rgba(224, 92, 92, 0.35); }
