--- a/frontend/styles.css	2026-10-08 09:50:29.353083596 +0000
+++ b/frontend/styles.css	2026-10-08 09:50:29.355219820 +0000
@@ -11753,3 +11753,107 @@
   overflow-wrap: anywhere;
 }
 .session-item .session-action { flex: 0 0 auto; margin-left: auto; }
+
+/* ─── Chat page: header, partner picker, menus and composer bars ───────────
+   Same gold-on-dark pill / rounded-card language as Mentors, Live and Profile. */
+.chat-header .icon-btn {
+  width: 40px;
+  height: 40px;
+  background: rgba(201, 168, 76, 0.13);
+  border: 0;
+  color: var(--gold-light);
+  box-shadow: inset 0 0 0 1px rgba(201, 168, 76, 0.28);
+}
+.chat-header .icon-btn:hover,
+.chat-header .icon-btn:active { background: rgba(201, 168, 76, 0.24); }
+.chat-header .icon-btn svg { width: 18px; height: 18px; }
+
+/* "Select mentee" dropdown button: compact pill that fits its text */
+.chat-partner-btn {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  height: 40px;
+  max-width: 190px;
+  padding: 0 14px;
+  flex: 0 1 auto;
+  border-radius: 999px;
+  border: 1px solid rgba(201, 168, 76, 0.4);
+  background: linear-gradient(180deg, rgba(201, 168, 76, 0.2), rgba(201, 168, 76, 0.06)), rgba(255, 255, 255, 0.03);
+  color: var(--gold-light);
+  font-family: var(--font-body);
+  font-size: 0.86rem;
+  font-weight: 700;
+  cursor: pointer;
+  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.26), inset 0 1px 0 rgba(255, 233, 160, 0.16);
+  transition: transform 0.15s ease, border-color 0.2s ease;
+}
+.chat-partner-btn:active { transform: scale(0.97); }
+.chat-partner-btn svg { flex: none; }
+.chat-partner-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+[data-theme="light"] .chat-partner-btn { color: #6B4E0F; border-color: rgba(150, 120, 40, 0.42); background: linear-gradient(180deg, rgba(201, 168, 76, 0.26), rgba(201, 168, 76, 0.1)), #fffaf0; }
+
+/* floating menus = rounded cards with roomy, even rows */
+.chat-header .overflow-menu,
+.chat-partner-menu {
+  width: auto;
+  min-width: 210px;
+  padding: 8px;
+  border-radius: 22px;
+  border: 1px solid rgba(255, 255, 255, 0.09);
+  background: linear-gradient(160deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02)), #12141b;
+  box-shadow: 0 18px 44px rgba(0, 0, 0, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.06);
+}
+.chat-header .menu-item,
+.chat-partner-menu .msg-menu-item {
+  min-height: 46px;
+  padding: 0 14px;
+  gap: 12px;
+  border-radius: 16px;
+  font-size: 0.92rem;
+  white-space: nowrap;
+}
+.chat-header .menu-item svg { width: 18px; height: 18px; }
+.chat-header .menu-item:hover,
+.chat-partner-menu .msg-menu-item:hover { background: rgba(201, 168, 76, 0.12); color: var(--gold-light); }
+.chat-header .menu-item.danger:hover { background: rgba(224, 92, 92, 0.16); color: var(--danger); }
+.chat-partner-item { justify-content: space-between; font-weight: 600; }
+.chat-partner-item-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.chat-partner-item.active {
+  color: var(--gold-light);
+  font-weight: 700;
+  background: linear-gradient(160deg, rgba(201, 168, 76, 0.22), rgba(201, 168, 76, 0.07));
+  box-shadow: inset 0 0 0 1px rgba(201, 168, 76, 0.38);
+}
+.chat-partner-badge { min-width: 20px; height: 20px; border-radius: 10px; }
+[data-theme="light"] .chat-header .overflow-menu,
+[data-theme="light"] .chat-partner-menu { background: #fffaf0; border-color: rgba(150, 120, 40, 0.3); box-shadow: 0 16px 36px rgba(30, 25, 15, 0.2); }
+
+/* reply / edit bars above the composer */
+.reply-indicator,
+.edit-indicator {
+  gap: 10px;
+  padding: 8px 8px 8px 14px;
+  border-radius: 18px;
+  border-left-width: 4px;
+}
+.reply-indicator-icon, .edit-indicator-icon { width: 18px; height: 18px; }
+.reply-indicator-label, .edit-indicator-label { font-size: 0.78rem; }
+.reply-cancel,
+.edit-cancel {
+  flex: none;
+  width: 32px;
+  height: 32px;
+  display: grid;
+  place-items: center;
+  padding: 0;
+  border: 0;
+  border-radius: 50%;
+  background: rgba(255, 255, 255, 0.08);
+  color: var(--text2);
+  cursor: pointer;
+  transition: background 0.15s ease, color 0.15s ease;
+}
+.reply-cancel svg, .edit-cancel svg { width: 16px; height: 16px; }
+.reply-cancel:hover, .edit-cancel:hover,
+.reply-cancel:active, .edit-cancel:active { background: rgba(224, 92, 92, 0.2); color: var(--danger); }
