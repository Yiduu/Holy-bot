   return `
     <div class="mc-card ${unavailable ? 'muted' : ''}" data-mentor-id="${id}" onclick="mentorCardClick(event, ${id})">
       <div class="mc-top">
         ${halo}
         <div class="mc-main">
           <div class="mc-name">${escapeHtml(name)}</div>
