+/* ── Apply to become a mentor page – same family as New support request / End mentorship ──
+   Gold glow hero, glass card, pill chips (replaces the old dropdown-in-a-sheet), docked action bar.
+   The nav steps aside (body.er-page) and the page follows the visible height, so the fields and
+   the buttons are never covered by the nav or the keyboard. ── */
+#page-apply-mentor.active {
+  background: radial-gradient(120% 420px at 50% 0%, rgba(201, 168, 76, 0.28) 0%, rgba(168, 124, 42, 0.11) 45%, transparent 78%) no-repeat;
+}
+[data-theme="light"] #page-apply-mentor.active {
+  background: radial-gradient(120% 420px at 50% 0%, rgba(201, 168, 76, 0.32) 0%, rgba(201, 168, 76, 0.10) 45%, transparent 78%) no-repeat;
+}
+#page-apply-mentor .app-header { background: transparent; border-bottom-color: transparent; box-shadow: none; }
+body.kb-open #page-apply-mentor.active { flex: 0 0 auto; height: calc(var(--app-height) - var(--kb-inset, 0px)); }
+
+#page-apply-mentor .page-content.ma-content {
+  display: flex; flex-direction: column; gap: 14px; min-height: 0;
+  padding: 2px 16px 24px; overscroll-behavior-y: contain;
+  animation: profilePaneIn 0.3s ease both;
+}
+#page-apply-mentor .ma-content > * { flex-shrink: 0; }
+
+#page-apply-mentor .ma-hero { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 6px; padding: 2px 6px; }
+#page-apply-mentor .ma-hero-icon {
+  width: 60px; height: 60px; display: grid; place-items: center; margin-bottom: 8px;
+  border-radius: 21px; color: var(--gold-light);
+  background: radial-gradient(90% 90% at 50% 0%, rgba(232, 201, 107, 0.26), rgba(201, 168, 76, 0.08)), rgba(201, 168, 76, 0.10);
+  box-shadow: inset 0 0 0 1px rgba(232, 201, 107, 0.34), 0 12px 28px rgba(0, 0, 0, 0.38), 0 0 38px rgba(201, 168, 76, 0.20);
+}
+#page-apply-mentor .ma-hero .page-intro-eyebrow { margin-bottom: 2px; }
+#page-apply-mentor .ma-hero-text { max-width: 34ch; color: var(--text2); line-height: 1.5; }
+[data-theme="light"] #page-apply-mentor .ma-hero-icon { color: #7A5812; box-shadow: inset 0 0 0 1px rgba(150, 120, 40, 0.34), 0 10px 22px rgba(30, 25, 15, 0.14), 0 0 30px rgba(201, 168, 76, 0.24); }
+
+#page-apply-mentor .ma-form {
+  display: flex; flex-direction: column; gap: 18px; padding: 18px 16px;
+  border-color: rgba(201, 168, 76, 0.28);
+  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.28), var(--inset-hi);
+}
+[data-theme="light"] #page-apply-mentor .ma-form { background: linear-gradient(160deg, #fff, #f6f3ea); border-color: rgba(150, 120, 40, 0.28); box-shadow: 0 8px 20px rgba(30, 25, 15, 0.10), inset 0 1px 0 #fff; }
+#page-apply-mentor .ma-field { display: flex; flex-direction: column; gap: 8px; }
+#page-apply-mentor .ma-label { font-size: var(--fs-xs); font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--gold-light); }
+[data-theme="light"] #page-apply-mentor .ma-label { color: #7A5812; }
+
+#page-apply-mentor .ma-input {
+  display: block; width: 100%; box-sizing: border-box; padding: 13px 16px;
+  border-radius: 16px; font-size: 16px; line-height: 1.5;      /* 16px: no iOS zoom on focus */
+  background: rgba(0, 0, 0, 0.28); border: 1px solid rgba(255, 255, 255, 0.10);
+  box-shadow: 0 0 0 0 transparent, inset 0 2px 6px rgba(0, 0, 0, 0.35);
+  scroll-margin-block: 96px;
+}
+#page-apply-mentor input.ma-input { min-height: 52px; }
