+// True when this user is currently "focused" on one chat partner AND has more
+// than one partner (focus only matters when there is someone to switch to).
+async function hasActiveFocus(chatId) {
+  const state = getState(chatId);
+  if (state?.step !== 'chat_active' || !state.targetId) return false;
+  const info = await getActiveChatPartners(chatId);
+  return !!info && info.partners.length > 1;
+}
+
+// Sends the "you are now chatting with X" message with the End chat button
+// attached to the bottom keyboard.
+async function sendFocusSet(chatId, lang, nick) {
+  const { data: user } = await supabase.from('users').select('role').eq('telegram_id', chatId).single();
+  return safeSend(chatId, tSync(lang, 'focus_set', { nick: mdEscape(nick) }), {
+    reply_markup: buildPersistentKeyboard(user?.role || 'user', lang, true)
+  });
+}
+
+// Releases the focus and restores the normal menu (no End chat button).
+async function endFocus(chatId, lang) {
+  const state = getState(chatId);
+  if (state?.step === 'chat_active') {
+    clearState(chatId);
+    return showPersistentMenu(chatId, tSync(lang, 'focus_cleared'));
+  }
+  return showPersistentMenu(chatId, tSync(lang, 'focus_none'));
+}
