+
+/* ═══ Journal entry sheet — same language as the Edit Profile sheet ═══════
+   Gold-glow header, centred title, uppercase gold labels, pill toolbar, soft
+   rounded writing surface and big pill actions. Two views share the sheet:
+   READ (existing entry: date, mood, full text, Edit / Delete) and EDIT. ═══ */
+.journal-sheet {
+  max-width: 460px;
+  margin: 0 auto;
+  padding: 18px 20px calc(22px + var(--safe-bottom, 0px));
+  border-radius: 30px 30px 0 0;
+  background:
+    radial-gradient(120% 220px at 50% 0%, rgba(201, 168, 76, 0.18) 0%, rgba(201, 168, 76, 0.05) 55%, transparent 85%) no-repeat,
+    var(--bg2);
+}
+.journal-sheet .modal-title {
+  text-align: center;
+  font-size: var(--fs-xl, 1.25rem);
+  letter-spacing: 0.04em;
+  margin-bottom: 18px;
+}
+.journal-sheet .form-group { margin-top: 18px; }
+.journal-sheet .form-label {
+  display: block;
+  margin: 0 0 8px 6px;
+  font-size: var(--fs-xs);
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 0.14em;
+  color: var(--gold-light);
+}
+
+/* mood: three soft cards, selected one glows gold */
+.journal-sheet .mood-picker { gap: 10px; margin: 0; }
+.journal-sheet .mood-option {
+  padding: 12px 6px 10px;
+  border-radius: 20px;
+  border: 1px solid rgba(255, 255, 255, 0.08);
+  background: rgba(255, 255, 255, 0.04);
+  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
+}
+.journal-sheet .mood-option .mood-label { font-size: var(--fs-xs); font-weight: 600; }
+.journal-sheet .mood-option.selected {
+  transform: none;
+  border-color: rgba(201, 168, 76, 0.6);
+  background: rgba(201, 168, 76, 0.16);
+  box-shadow: 0 8px 22px rgba(201, 168, 76, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.1);
+}
+.journal-sheet .mood-option.selected .mood-svg,
+.journal-sheet .mood-option.selected .mood-label { color: var(--gold-light); }
+
+/* writing surface: toolbar + textarea in one rounded card */
+.journal-editor {
+  border-radius: 22px;
+  background: rgba(255, 255, 255, 0.05);
+  border: 1px solid rgba(255, 255, 255, 0.10);
+  box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.25);
+  overflow: hidden;
+  transition: border-color 0.2s ease, box-shadow 0.2s ease;
+}
+.journal-editor:focus-within {
+  border-color: var(--gold);
+  box-shadow: 0 0 0 3px rgba(201, 168, 76, 0.18);
+}
+.journal-toolbar {
+  display: flex;
+  gap: 6px;
+  padding: 8px 10px;
+  border-bottom: 1px solid rgba(255, 255, 255, 0.07);
+}
+.journal-fmt-btn {
+  min-width: 38px;
+  height: 34px;
+  padding: 0 12px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  border: 1px solid rgba(201, 168, 76, 0.22);
+  border-radius: 999px;
+  background: rgba(201, 168, 76, 0.08);
+  color: var(--gold-light);
+  font-family: var(--font-body);
+  font-size: var(--fs-sm);
+  cursor: pointer;
+  transition: background 0.2s ease, transform 0.15s ease;
+}
+.journal-fmt-btn:active { transform: scale(0.94); background: rgba(201, 168, 76, 0.2); }
+.journal-editor .form-control,
+.journal-editor textarea {
+  display: block;
+  width: 100%;
+  min-height: 190px;
+  max-height: 38vh;
+  padding: 14px 18px;
+  border: 0;
+  border-radius: 0;
+  background: transparent;
+  box-shadow: none;
+  resize: none;
+  font-size: var(--fs-md, var(--fs-base));
+  line-height: 1.55;
+}
+.journal-editor .form-control:focus,
+.journal-editor textarea:focus { border: 0; box-shadow: none; transform: none; background: transparent; }
+
+/* read view */
+.journal-read-head {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  padding-bottom: 14px;
+  margin-bottom: 14px;
+  border-bottom: 1px solid rgba(255, 255, 255, 0.07);
+}
+.journal-read-head .journal-mood { width: 46px; height: 46px; margin: 0; }
+.journal-read-head .journal-mood .mood-svg { width: 22px; height: 22px; }
+.journal-read-meta { flex: 1; min-width: 0; }
+.journal-read-date { font-size: var(--fs-sm); font-weight: 700; color: var(--text); }
+.journal-read-mood-label {
+  margin-top: 2px;
+  font-size: var(--fs-xs);
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 0.12em;
+  color: var(--gold-light);
+}
+.journal-icon-btn {
+  flex: 0 0 auto;
+  width: 42px;
+  height: 42px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  border-radius: 50%;
+  border: 1px solid rgba(255, 255, 255, 0.10);
+  background: rgba(255, 255, 255, 0.05);
+  color: var(--text2);
+  cursor: pointer;
+  transition: transform 0.15s ease, background 0.2s ease, color 0.2s ease;
+}
+.journal-icon-btn.danger { color: var(--danger); border-color: rgba(224, 92, 92, 0.3); background: rgba(224, 92, 92, 0.08); }
+.journal-icon-btn:active { transform: scale(0.92); }
+.journal-read-body {
+  max-height: 46vh;
+  overflow-y: auto;
+  -webkit-overflow-scrolling: touch;
+  padding: 2px 4px 2px 2px;
+  font-size: var(--fs-md, var(--fs-base));
+  line-height: 1.65;
+  color: var(--text);
+  overflow-wrap: anywhere;
+}
+
+/* actions */
+.journal-actions { display: flex; gap: 10px; margin-top: 22px; }
+.journal-actions .btn { min-height: 52px; font-size: var(--fs-md, var(--fs-base)); font-weight: 700; }
+.journal-actions .btn-primary { flex: 1.4; }
+
+/* light theme */
+[data-theme="light"] .journal-sheet {
+  background:
+    radial-gradient(120% 220px at 50% 0%, rgba(201, 168, 76, 0.28) 0%, rgba(201, 168, 76, 0.08) 55%, transparent 85%) no-repeat,
+    #fbf8f0;
+}
+[data-theme="light"] .journal-sheet .form-label,
+[data-theme="light"] .journal-read-mood-label { color: #7A5812; }
+[data-theme="light"] .journal-sheet .mood-option {
+  background: #fff;
+  border-color: rgba(150, 120, 40, 0.22);
+  box-shadow: 0 4px 12px rgba(30, 25, 15, 0.06), inset 0 1px 0 #fff;
+}
+[data-theme="light"] .journal-sheet .mood-option.selected {
+  background: rgba(201, 168, 76, 0.2);
+  border-color: rgba(150, 120, 40, 0.55);
+}
+[data-theme="light"] .journal-sheet .mood-option.selected .mood-svg,
+[data-theme="light"] .journal-sheet .mood-option.selected .mood-label { color: #7A5812; }
+[data-theme="light"] .journal-editor {
+  background: #fff;
+  border-color: rgba(150, 120, 40, 0.28);
+  box-shadow: inset 0 1px 3px rgba(30, 25, 15, 0.08);
+}
+[data-theme="light"] .journal-toolbar { border-bottom-color: rgba(150, 120, 40, 0.16); }
+[data-theme="light"] .journal-fmt-btn { color: #7A5812; background: rgba(201, 168, 76, 0.14); border-color: rgba(150, 120, 40, 0.3); }
+[data-theme="light"] .journal-read-head { border-bottom-color: rgba(150, 120, 40, 0.18); }
+[data-theme="light"] .journal-icon-btn { background: #fff; border-color: rgba(150, 120, 40, 0.25); }
+[data-theme="light"] .journal-icon-btn.danger { background: rgba(224, 92, 92, 0.08); border-color: rgba(224, 92, 92, 0.35); }
+[data-theme="light"] .journal-sheet .modal-title { color: #7A5812; }
