--- a/frontend/styles.css
+++ b/frontend/styles.css
@@ -12024,3 +12024,13 @@
 .sd-box.is-today.is-read .sd-medal { border: 0; background: linear-gradient(180deg, #F1D786, #C9A84C); color: #1a1300; }
 .sd-box.is-today .sd-num { color: #fff; }
 .sd-box.is-today .sd-cap { color: #1a1300; font-weight: 900; background: linear-gradient(180deg, #F1D786, #C9A84C); }
+
+/* ─── Bottom nav: larger, easier to tap (portrait phones) ──────────────────
+   --nav-h drives every page's bottom padding, so content makes room automatically. */
+@media not all and (orientation: landscape) and (max-height: 500px) {
+  :root { --nav-h: 82px; }
+  .bottom-nav { border-radius: 32px; padding: 0 8px; gap: 4px; }
+  .nav-item { margin: 6px 0; gap: 4px; border-radius: 24px; }
+  .nav-item svg { width: 25px; height: 25px; }
+  .nav-item span:not(.nav-badge) { font-size: clamp(0.62rem, 2.9vw, 0.74rem); font-weight: 700; }
+}
