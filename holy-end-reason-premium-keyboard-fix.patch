+/* ── End mentorship page (mentor) ─────────────────────────────────────────
+   A focused, premium "write your reason" page: gold glow behind a warm hero, glass
+   cards, gold pills, and an action bar that sits OUTSIDE the scrolling area.
+   Why the field used to disappear: the floating nav (fixed, z-index 9999) stayed
+   on screen above the keyboard and the page kept reserving room for it, so the
+   textarea ended up underneath. On this page the nav steps aside (body.er-page,
+   set in app.js), the page follows the visible height, and the buttons dock at
+   the bottom so the field always has the room that is left. ── */
+#page-end-mentorship.active {
+  background: radial-gradient(120% 420px at 50% 0%, rgba(201, 168, 76, 0.28) 0%, rgba(168, 124, 42, 0.11) 45%, transparent 78%) no-repeat;
+}
+[data-theme="light"] #page-end-mentorship.active {
+  background: radial-gradient(120% 420px at 50% 0%, rgba(201, 168, 76, 0.32) 0%, rgba(201, 168, 76, 0.10) 45%, transparent 78%) no-repeat;
+}
+#page-end-mentorship .app-header { background: transparent; border-bottom-color: transparent; box-shadow: none; }
+
+/* nav steps aside: nothing floats over the field or the buttons */
+body.er-page .bottom-nav { display: none !important; }
+/* keyboard open: grow/shrink with the visible area (also where the WebView does not resize itself) */
+body.kb-open #page-end-mentorship.active { flex: 0 0 auto; height: calc(var(--app-height) - var(--kb-inset, 0px)); }
+
+#page-end-mentorship .page-content.er-content {
+  display: flex; flex-direction: column; gap: 14px; min-height: 0;
+  padding: 2px 16px 24px;
+  overscroll-behavior-y: contain;
+  animation: profilePaneIn 0.3s ease both;
+}
+/* flex children must never be squeezed by the scroll container */
+#page-end-mentorship .er-content > * { flex-shrink: 0; }
+
+/* hero */
+#page-end-mentorship .er-hero { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 6px; padding: 2px 6px 2px; }
+#page-end-mentorship .er-hero-icon {
+  width: 64px; height: 64px; display: grid; place-items: center; margin-bottom: 8px;
+  border-radius: 22px; color: var(--gold-light);
+  background: radial-gradient(90% 90% at 50% 0%, rgba(232, 201, 107, 0.26), rgba(201, 168, 76, 0.08)), rgba(201, 168, 76, 0.10);
+  box-shadow: inset 0 0 0 1px rgba(232, 201, 107, 0.34), 0 12px 28px rgba(0, 0, 0, 0.38), 0 0 38px rgba(201, 168, 76, 0.20);
+}
+#page-end-mentorship .er-hero .page-intro-eyebrow { margin-bottom: 2px; }
+#page-end-mentorship .er-hero-text { max-width: 34ch; color: var(--text2); line-height: 1.5; }
+[data-theme="light"] #page-end-mentorship .er-hero-icon { color: #7A5812; box-shadow: inset 0 0 0 1px rgba(150, 120, 40, 0.34), 0 10px 22px rgba(30, 25, 15, 0.14), 0 0 30px rgba(201, 168, 76, 0.24); }
+
+/* who it is for */
+#page-end-mentorship .er-who {
+  display: flex; align-items: center; gap: 14px; padding: 14px 16px;
+  border-color: rgba(201, 168, 76, 0.22);
+  background: radial-gradient(120% 180% at 0% 0%, rgba(201, 168, 76, 0.12), transparent 62%), var(--surface);
+  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.26), var(--inset-hi);
+}
+#page-end-mentorship .er-who .mentor-avatar { width: 52px; height: 52px; flex: none; box-shadow: 0 0 0 2px rgba(201, 168, 76, 0.45), 0 6px 16px rgba(0, 0, 0, 0.35); }
 #page-end-mentorship .er-who-txt { min-width: 0; }
 #page-end-mentorship .er-who-name { font: 800 var(--fs-lg) var(--font-body); color: var(--text); line-height: 1.25; overflow-wrap: anywhere; }
-#page-end-mentorship .er-who-sub { margin-top: 2px; font-size: var(--fs-xs); color: var(--text2); }
-#page-end-mentorship .er-form { display: flex; flex-direction: column; gap: 8px; padding: 16px; border-color: rgba(201, 168, 76, 0.28); }
-#page-end-mentorship .er-label { font-size: var(--fs-xs); font-weight: 700; letter-spacing: .04em; color: var(--gold); }
-#page-end-mentorship textarea { width: 100%; box-sizing: border-box; resize: none; min-height: 140px; border-radius: 16px; scroll-margin-block: 96px; }
-#page-end-mentorship .er-foot { display: flex; justify-content: space-between; gap: 8px; font-size: var(--fs-2xs); color: var(--text3); }
-#page-end-mentorship .er-note { margin: 0 4px; font-size: var(--fs-xs); line-height: 1.45; color: var(--text2); }
-#page-end-mentorship .er-actions { display: flex; gap: 10px; margin-top: 4px; }
-#page-end-mentorship .er-actions .btn { flex: 1; min-height: 48px; }
-#page-end-mentorship .er-actions .btn:disabled { opacity: .45; pointer-events: none; }
