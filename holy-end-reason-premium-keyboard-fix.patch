+[data-theme="light"] #page-end-mentorship .er-form { background: linear-gradient(160deg, #fff, #f6f3ea); border-color: rgba(150, 120, 40, 0.28); box-shadow: 0 8px 20px rgba(30, 25, 15, 0.10), inset 0 1px 0 #fff; }
+#page-end-mentorship .er-label { font-size: var(--fs-xs); font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--gold-light); }
+[data-theme="light"] #page-end-mentorship .er-label { color: #7A5812; }
+#page-end-mentorship textarea {
+  display: block; width: 100%; box-sizing: border-box; resize: none;
+  min-height: 132px; max-height: 240px; padding: 14px 16px;
+  border-radius: 18px; font-size: 16px; line-height: 1.55;      /* 16px: no iOS zoom on focus */
+  background: rgba(0, 0, 0, 0.28); border: 1px solid rgba(255, 255, 255, 0.10);
+  box-shadow: 0 0 0 0 transparent, inset 0 2px 6px rgba(0, 0, 0, 0.35);
+  scroll-margin-block: 96px;
+}
+#page-end-mentorship textarea:focus { border-color: var(--gold); box-shadow: 0 0 0 3px var(--gold-dim), inset 0 2px 6px rgba(0, 0, 0, 0.35); }
+[data-theme="light"] #page-end-mentorship textarea { background: rgba(255, 255, 255, 0.92); border-color: rgba(150, 120, 40, 0.25); box-shadow: 0 0 0 0 transparent, inset 0 1px 3px rgba(30, 25, 15, 0.08); }
+[data-theme="light"] #page-end-mentorship textarea:focus { border-color: #A87C2A; box-shadow: 0 0 0 3px var(--gold-dim), inset 0 1px 3px rgba(30, 25, 15, 0.08); }
+
+#page-end-mentorship .er-foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-size: var(--fs-xs); color: var(--text3); }
+#page-end-mentorship .er-hint { display: inline-flex; align-items: center; gap: 7px; min-width: 0; }
+#page-end-mentorship .er-hint-dot { width: 7px; height: 7px; flex: none; border-radius: 50%; background: var(--text3); opacity: .6; transition: background .2s ease, box-shadow .2s ease, opacity .2s ease; }
+#page-end-mentorship .er-hint.is-ok { color: var(--text2); }
+#page-end-mentorship .er-hint.is-ok .er-hint-dot { background: var(--success); opacity: 1; box-shadow: 0 0 10px rgba(91, 173, 122, 0.7); }
+#page-end-mentorship .er-count { flex: none; font-variant-numeric: tabular-nums; font-weight: 700; }
+#page-end-mentorship .er-count.is-near { color: var(--danger); }
+
+#page-end-mentorship .er-note { display: flex; align-items: flex-start; gap: 8px; margin: 0 4px; font-size: var(--fs-xs); line-height: 1.5; color: var(--text2); }
+#page-end-mentorship .er-note svg { flex: none; margin-top: 2px; color: var(--gold-light); }
+[data-theme="light"] #page-end-mentorship .er-note svg { color: #7A5812; }
+
+/* docked action bar: never inside the scroll area, never behind the nav or the keyboard */
+#page-end-mentorship .er-actions-bar {
+  flex: none; padding: 12px 16px calc(14px + var(--safe-bottom));
+  background: linear-gradient(180deg, transparent, var(--bg) 38%);
+  border-top: 1px solid var(--border-dim);
+}
+body.kb-open #page-end-mentorship .er-actions-bar { padding-bottom: 12px; }
+#page-end-mentorship .er-actions { display: flex; gap: 10px; }
+#page-end-mentorship .er-actions .btn { flex: 1; min-height: 50px; }
+#page-end-mentorship .er-actions .btn-danger { flex: 1.25; background: linear-gradient(180deg, rgba(224, 92, 92, 0.30), rgba(224, 92, 92, 0.16)); border-color: rgba(224, 92, 92, 0.5); box-shadow: 0 8px 22px rgba(224, 92, 92, 0.18), inset 0 1px 0 rgba(255, 255, 255, 0.10); }
+#page-end-mentorship .er-actions .btn:disabled { opacity: .45; pointer-events: none; box-shadow: none; }
+[data-theme="light"] #page-end-mentorship .er-actions-bar { background: linear-gradient(180deg, transparent, var(--bg) 38%); }
+[data-theme="light"] #page-end-mentorship .er-actions .btn-danger { color: #B03434; }
+
+/* keyboard open: keep only what is needed to write, so the field gets the room */
+body.kb-open #page-end-mentorship .er-hero-icon,
+body.kb-open #page-end-mentorship .er-hero-text,
+body.kb-open #page-end-mentorship .er-note { display: none; }
+body.kb-open #page-end-mentorship textarea { min-height: 112px; }
+
+@media (prefers-reduced-motion: reduce) { #page-end-mentorship .er-content { animation: none; } }
