-@media (prefers-reduced-motion: reduce) { #page-end-mentorship.active .page-content { animation: none; } }
+#page-end-mentorship .er-who-sub { margin-top: 2px; font-size: var(--fs-xs); font-weight: 600; letter-spacing: .06em; color: var(--gold-light); }
+[data-theme="light"] #page-end-mentorship .er-who { background: radial-gradient(120% 180% at 0% 0%, rgba(201, 168, 76, 0.18), transparent 62%), #fffaf0; border-color: rgba(150, 120, 40, 0.28); box-shadow: 0 8px 20px rgba(30, 25, 15, 0.10), inset 0 1px 0 #fff; }
