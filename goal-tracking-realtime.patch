+/* ─── Live connection indicator ──────────────────────────────────
+   Small dot next to "My Goals" — green/gold pulse while the socket
+   is connected, solid red once it drops, back to pulsing on reconnect. */
+.live-dot {
+  display: inline-block;
+  width: 7px;
+  height: 7px;
+  border-radius: 50%;
+  flex-shrink: 0;
+  margin-left: 2px;
+}
+
+.live-dot--live {
+  background: var(--gold, #D4AF37);
+  box-shadow: 0 0 0 0 rgba(212, 175, 55, 0.55);
+  animation: liveDotPulse 1.8s ease-out infinite;
+}
+
+.live-dot--offline {
+  background: var(--danger, #e05c5c);
+  box-shadow: none;
+  animation: none;
+}
+
+@keyframes liveDotPulse {
+  0% {
+    box-shadow: 0 0 0 0 rgba(212, 175, 55, 0.55);
+  }
+
+  70% {
+    box-shadow: 0 0 0 6px rgba(212, 175, 55, 0);
+  }
+
+  100% {
+    box-shadow: 0 0 0 0 rgba(212, 175, 55, 0);
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .live-dot--live {
+    animation: none !important;
+  }
+}
+
 /* ─── Session time labels ────────────────────────────────────── */
 .session-time-label {
   display: inline-flex;
