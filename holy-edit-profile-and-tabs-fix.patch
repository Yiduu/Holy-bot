+
+/* ═══ Edit Profile sheet — same language as the Profile page ═══
+   Framed photo with a gold glow and gold camera button, uppercase gold labels,
+   a pill-shaped field, the info rows as soft cards and a big gold Save pill.
+   Every id / onclick the sheet already uses is unchanged. ═══ */
+.edit-profile-sheet {
+  padding: 18px 20px calc(22px + var(--safe-bottom, 0px));
+  border-radius: 30px 30px 0 0;
+  background:
+    radial-gradient(120% 220px at 50% 0%, rgba(201, 168, 76, 0.18) 0%, rgba(201, 168, 76, 0.05) 55%, transparent 85%) no-repeat,
+    var(--bg2);
+}
+.edit-profile-sheet .modal-title {
+  text-align: center;
+  font-size: var(--fs-xl, 1.25rem);
+  letter-spacing: 0.04em;
+  margin-bottom: 18px;
+}
+
+/* photo: centred, framed like the Profile hero, actions underneath */
+.edit-profile-sheet .edit-profile-avatar-row { flex-direction: column; justify-content: center; gap: 16px; }
+.edit-profile-sheet .avatar-preview-wrap {
+  padding: 5px;
+  border-radius: 34px;
+  background: linear-gradient(160deg, rgba(255, 255, 255, 0.10), rgba(255, 255, 255, 0.02));
+  border: 1px solid rgba(255, 255, 255, 0.10);
+  box-shadow: 0 14px 34px rgba(0, 0, 0, 0.5), 0 0 30px rgba(201, 168, 76, 0.24);
+}
+.edit-profile-sheet .avatar-camera-btn {
+  right: -6px;
+  bottom: -6px;
+  width: 38px;
+  height: 38px;
+  color: #1a1300;
+  background: linear-gradient(180deg, #EBCD72, #C9A84C);
+  border: 3px solid var(--bg2);
+  box-shadow: 0 6px 16px rgba(201, 168, 76, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.4);
+}
+.edit-profile-sheet .avatar-camera-btn svg { width: 16px; height: 16px; }
+.edit-profile-sheet .edit-profile-avatar-actions { justify-content: center; }
+.edit-profile-sheet .edit-profile-hint { margin: 14px 8px 0; text-align: center; color: var(--text3); }
+
+/* display name */
+.edit-profile-sheet .form-group { margin-top: 20px; }
+.edit-profile-sheet .form-label { margin: 0 0 8px 6px; letter-spacing: 0.14em; color: var(--gold-light); }
+.edit-profile-sheet .input {
+  padding: 14px 20px;
+  border-radius: 999px;
+  background: rgba(255, 255, 255, 0.05);
+  border: 1px solid rgba(255, 255, 255, 0.10);
+  box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.25);
+}
+.edit-profile-sheet .input:focus {
+  transform: none;
+  background: rgba(255, 255, 255, 0.07);
+  border-color: var(--gold);
+  box-shadow: 0 0 0 3px rgba(201, 168, 76, 0.18);
+}
+
+/* Anonymous ID / Role rows as soft cards */
+.edit-profile-sheet .edit-profile-meta-row {
+  margin-top: 10px;
+  padding: 12px 18px;
+  border: 1px solid rgba(255, 255, 255, 0.07);
+  border-radius: 22px;
+  background: linear-gradient(160deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.015)), #111319;
+  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
+}
+.edit-profile-sheet .form-group + .edit-profile-meta-row { margin-top: 18px; }
+
+.edit-profile-sheet .btn-primary.btn-full { min-height: 54px; margin-top: 22px; font-size: var(--fs-md); font-weight: 700; }
+
+[data-theme="light"] .edit-profile-sheet {
+  background:
+    radial-gradient(120% 220px at 50% 0%, rgba(201, 168, 76, 0.28) 0%, rgba(201, 168, 76, 0.08) 55%, transparent 85%) no-repeat,
+    #fbf8f0;
+}
+[data-theme="light"] .edit-profile-sheet .avatar-preview-wrap {
+  background: rgba(255, 255, 255, 0.8);
+  border-color: rgba(150, 120, 40, 0.25);
+  box-shadow: 0 12px 28px rgba(30, 25, 15, 0.16), 0 0 24px rgba(201, 168, 76, 0.22);
+}
+[data-theme="light"] .edit-profile-sheet .avatar-camera-btn { border-color: #fbf8f0; }
+[data-theme="light"] .edit-profile-sheet .form-label { color: #7A5812; }
+[data-theme="light"] .edit-profile-sheet .input {
+  background: #fff;
+  border-color: rgba(150, 120, 40, 0.28);
+  box-shadow: inset 0 1px 3px rgba(30, 25, 15, 0.08);
+}
+[data-theme="light"] .edit-profile-sheet .edit-profile-meta-row {
+  background: linear-gradient(160deg, #fff, #f6f3ea);
+  border-color: rgba(150, 120, 40, 0.2);
+  box-shadow: 0 6px 16px rgba(30, 25, 15, 0.10), inset 0 1px 0 #fff;
+}
