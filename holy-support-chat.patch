+
+
+/* ═══ Support: request list + chat with the support team ═══════════════════════
+   List: same page header (Back / action pills), card shell and gold icon tiles as
+   Mentors, Mentees and Sessions. Chat: same header, bubbles, date dividers and
+   docked composer as the mentor chat. ═══ */
+
+/* ── request list ── */
+.ticket-list { display: flex; flex-direction: column; gap: 16px; }
+
+.sp-new {
+  color: #1a1300;
+  background: linear-gradient(180deg, #EBCD72, #C9A84C);
+  border-color: rgba(255, 233, 160, 0.55);
+  box-shadow: 0 8px 22px rgba(201, 168, 76, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.4);
+}
+.sp-new svg { color: #1a1300; }
+[data-theme="light"] .sp-new {
+  color: #1a1300;
+  background: linear-gradient(180deg, #EBCD72, #C9A84C);
+  border-color: rgba(255, 233, 160, 0.55);
+  box-shadow: 0 8px 20px rgba(201, 168, 76, 0.38), inset 0 1px 0 rgba(255, 255, 255, 0.4);
+}
+
+.ticket-card-premium {
+  display: flex;
+  flex-direction: column;
+  gap: 14px;
+  margin: 0;
+  padding: 18px;
+  border-radius: 26px;
+  border: 1px solid rgba(255, 255, 255, 0.07);
+  background: linear-gradient(160deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.015)), #111319;
+  box-shadow: 0 8px 22px rgba(0, 0, 0, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.05);
+  backdrop-filter: none;
+  -webkit-backdrop-filter: none;
+  transition: transform 0.15s ease, border-color 0.2s ease;
+}
+.ticket-card-premium::before { display: none; }
+.ticket-card-premium:hover { transform: none; border-color: rgba(201, 168, 76, 0.3); box-shadow: 0 8px 22px rgba(0, 0, 0, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.05); }
+.ticket-card-premium:active { transform: scale(0.985); }
+
+.ticket-card-head { display: flex; align-items: flex-start; gap: 14px; min-width: 0; }
+.ticket-tile {
+  width: 46px; height: 46px; flex: none;
+  display: flex; align-items: center; justify-content: center;
+  border-radius: 16px;
+  background: rgba(201, 168, 76, 0.13);
+  color: var(--gold-light);
+  box-shadow: inset 0 0 0 1px rgba(201, 168, 76, 0.24);
+}
+.ticket-tile-lg { width: 64px; height: 64px; border-radius: 22px; }
+.status-in_progress .ticket-tile { background: rgba(91, 142, 255, 0.14); color: #7AA5FF; box-shadow: inset 0 0 0 1px rgba(91, 142, 255, 0.3); }
+.status-resolved .ticket-tile { background: rgba(91, 173, 122, 0.14); color: #72C793; box-shadow: inset 0 0 0 1px rgba(91, 173, 122, 0.3); }
+.status-closed .ticket-tile { background: rgba(255, 255, 255, 0.06); color: var(--text3); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1); }
+
+.ticket-card-heading { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; padding-top: 2px; }
+.ticket-card-title {
+  margin: 0;
+  font-size: var(--fs-md);
+  font-weight: 800;
+  line-height: 1.3;
+  overflow-wrap: anywhere;
+  display: -webkit-box;
+  -webkit-line-clamp: 2;
+  line-clamp: 2;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+}
+.ticket-card-preview {
+  margin: 0;
+  padding: 10px 14px;
+  border-radius: 16px;
+  background: rgba(0, 0, 0, 0.22);
+  border: 1px solid rgba(255, 255, 255, 0.05);
+  color: var(--text2);
+  font-size: var(--fs-sm);
+  line-height: 1.45;
+  overflow-wrap: anywhere;
+}
+.ticket-card-preview strong { color: var(--gold-light); font-weight: 700; display: inline; }
+.ticket-card-meta {
+  display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap;
+  gap: 8px 10px; padding: 0; border-top: 0;
+}
+.ticket-card-info { display: inline-flex; align-items: center; gap: 6px; color: var(--text3); font-size: var(--fs-xs); font-weight: 600; }
+.ticket-card-info i { font-style: normal; opacity: 0.6; }
+.ticket-card-info svg { color: var(--gold-light); }
+.ticket-card-premium .ticket-resolved-strip { margin-top: 0; border-radius: 14px; }
+
+.ticket-empty {
+  display: flex; flex-direction: column; align-items: center; gap: 10px;
+  padding: 36px 22px; text-align: center;
+  border-radius: 26px;
+  border: 1px dashed rgba(201, 168, 76, 0.3);
+  background: radial-gradient(120% 140% at 50% 0%, rgba(201, 168, 76, 0.12), transparent 70%), #111319;
+}
+.ticket-empty-title { font-weight: 800; font-size: var(--fs-base); color: var(--text); }
+.ticket-empty-desc { margin: 0 0 6px; max-width: 280px; color: var(--text2); font-size: var(--fs-sm); line-height: 1.5; }
+.ticket-error { color: var(--danger); border-style: solid; border-color: rgba(224, 92, 92, 0.35); font-size: var(--fs-sm); }
+
+[data-theme="light"] .ticket-card-premium { background: linear-gradient(160deg, #fff, #f6f3ea); border-color: rgba(150, 120, 40, 0.2); box-shadow: 0 8px 20px rgba(30, 25, 15, 0.10), inset 0 1px 0 #fff; }
+[data-theme="light"] .ticket-card-preview { background: rgba(255, 255, 255, 0.75); border-color: rgba(150, 120, 40, 0.16); }
+[data-theme="light"] .ticket-card-preview strong, [data-theme="light"] .ticket-cat-label { color: #7A5812; }
+[data-theme="light"] .ticket-tile { background: rgba(201, 168, 76, 0.18); color: #7A5812; }
+[data-theme="light"] .ticket-card-info svg { color: #7A5812; }
+[data-theme="light"] .status-pill-open { color: #7A5812; }
+[data-theme="light"] .status-pill-in_progress { color: #2F5CC4; }
+[data-theme="light"] .status-pill-resolved { color: #2E7D4F; }
+[data-theme="light"] .ticket-empty { background: radial-gradient(120% 140% at 50% 0%, rgba(201, 168, 76, 0.2), transparent 70%), #fffaf0; border-color: rgba(150, 120, 40, 0.35); }
+
+/* ── chat with support ── */
+#page-ticket-detail.active { display: flex; flex-direction: column; background: none; }
+[data-theme="light"] #page-ticket-detail.active { background: none; }
+#page-ticket-detail.active .app-header { background: linear-gradient(180deg, var(--bg2), transparent); border-bottom: 1px solid var(--border-dim); }
+/* keyboard open: the nav hides (app.js), so the page grows to sit on the keyboard */
+body.kb-open #page-ticket-detail.active { flex: 0 0 auto; height: calc(var(--app-height) - var(--kb-inset, 0px)); }
+
+.ticket-chat-header { gap: 10px; }
+.ticket-chat-header .overflow-menu { min-width: 0; top: 38px; }
+.ticket-back { width: 40px; padding: 0; justify-content: center; flex: none; }
+.ticket-avatar svg { width: 20px; height: 20px; }
+.ticket-status { display: flex; align-items: center; gap: 6px; font-weight: 600; }
+.ticket-status .st-dot { width: 7px; height: 7px; border-radius: 50%; background: currentColor; flex: none; }
+.ticket-status.st-open { color: var(--gold-light); }
+.ticket-status.st-in_progress { color: #7AA5FF; }
+.ticket-status.st-resolved { color: #72C793; }
+.ticket-status.st-closed { color: var(--text3); }
+[data-theme="light"] .ticket-status.st-open { color: #7A5812; }
+[data-theme="light"] .ticket-status.st-in_progress { color: #2F5CC4; }
+[data-theme="light"] .ticket-status.st-resolved { color: #2E7D4F; }
+
+.ticket-chat-messages {
+  flex: 1;
+  min-height: 0;
+  overflow-y: auto;
+  padding: 16px 14px 12px;
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+  background: var(--bg);
+  -webkit-overflow-scrolling: touch;
+  overscroll-behavior: contain;
+}
+.ticket-chat-messages .message-text { white-space: pre-wrap; }
+.ticket-chat-messages .chat-date-divider { margin: 6px 0; }
+
+/* what the conversation is about: sits at the top of the thread, like a pinned header */
+.ticket-req-card {
+  align-self: center; width: 100%; max-width: 420px; box-sizing: border-box;
+  display: flex; flex-direction: column; align-items: center; gap: 6px;
+  padding: 14px 16px; text-align: center;
+  border-radius: 22px;
+  border: 1px solid rgba(201, 168, 76, 0.22);
+  background: radial-gradient(120% 140% at 50% 0%, rgba(201, 168, 76, 0.12), rgba(201, 168, 76, 0.03) 70%), rgba(255, 255, 255, 0.02);
+}
+.ticket-req-eyebrow { display: inline-flex; align-items: center; gap: 6px; font-size: var(--fs-2xs); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold-light); }
+.ticket-req-subject { font-weight: 800; font-size: var(--fs-md); line-height: 1.35; color: var(--text); overflow-wrap: anywhere; }
+.ticket-req-meta { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 4px 10px; font-size: var(--fs-xs); color: var(--text3); }
+[data-theme="light"] .ticket-req-eyebrow { color: #7A5812; }
+[data-theme="light"] .ticket-req-card { background: radial-gradient(120% 140% at 50% 0%, rgba(201, 168, 76, 0.2), rgba(201, 168, 76, 0.05) 70%), #fffaf0; border-color: rgba(150, 120, 40, 0.3); }
+
+.ticket-typing-row { padding: 4px 18px 8px; background: var(--bg); }
+.ticket-resolve-bar {
+  margin: 0; padding: 10px 14px; gap: 10px; flex-wrap: wrap;
+  background: var(--bg2); border-top: 1px solid var(--border-dim);
+}
+.ticket-resolve-note { color: var(--text2); }
+.ticket-resolve-note svg { color: var(--success); }
+.ticket-pill-btn {
+  display: inline-flex; align-items: center; gap: 6px; min-height: 36px; padding: 0 14px;
+  border-radius: 999px; cursor: pointer;
+  background: rgba(201, 168, 76, 0.13); border: 1px solid rgba(201, 168, 76, 0.35);
+  color: var(--gold-light); font: 700 var(--fs-xs) var(--font-body);
+}
+[data-theme="light"] .ticket-pill-btn { color: #7A5812; }
+
+/* composer: same pill + round send button as the mentor chat, docked above the nav */
+.ticket-composer {
+  position: relative;
+  display: flex; align-items: flex-end; gap: 8px; flex-shrink: 0;
+  padding: 10px 12px calc(10px + var(--nav-h) + var(--safe-bottom));
+  background: var(--bg2);
+  border-top: 1px solid var(--border);
+  box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.18);
+}
+body.kb-open .ticket-composer { padding-bottom: 10px; }
+.ticket-composer-field {
+  flex: 1 1 auto; min-width: 0;
+  display: flex; align-items: flex-end;
+  min-height: 42px; padding: 0 2px; box-sizing: border-box;
+  background: var(--bg3);
+  border: 1px solid var(--border-dim);
+  border-radius: 22px;
+  transition: border-color var(--transition), box-shadow var(--transition);
+}
+.ticket-composer-field:focus-within { border-color: var(--gold); box-shadow: 0 0 0 3px var(--gold-dim); }
+.ticket-composer-input {
+  flex: 1 1 auto; min-width: 0; min-height: 40px; max-height: 132px;
+  padding: 10px 14px; box-sizing: border-box;
+  background: transparent; border: 0; border-radius: 0; box-shadow: none; outline: none;
+  color: var(--text); font-family: inherit; font-size: var(--fs-md); line-height: 1.4;
+  resize: none; overflow-y: auto; scrollbar-width: none;
+}
+.ticket-composer-input::-webkit-scrollbar { display: none; }
+.ticket-composer-input::placeholder { color: var(--text3); }
+.ticket-send-btn {
+  width: 42px; height: 42px; min-width: 42px; flex: none; padding: 0;
+  display: flex; align-items: center; justify-content: center;
+  border: 0; border-radius: 50%; cursor: pointer;
+  background: linear-gradient(145deg, var(--gold), #a07020);
+  box-shadow: 0 3px 12px rgba(201, 168, 76, 0.35);
+  transition: transform 0.15s var(--ease-spring), box-shadow 0.15s, opacity 0.15s;
+}
+.ticket-send-btn svg { width: 19px; height: 19px; stroke: #1a1200; transform: translateX(1px); }
+.ticket-send-btn:active { transform: scale(0.93); }
+.ticket-send-btn:disabled { opacity: 0.5; cursor: default; }
+
+.ticket-closed-note {
+  display: flex;
+  flex-direction: column; align-items: center; gap: 10px; text-align: center; flex-shrink: 0;
+  padding: 14px 16px calc(14px + var(--nav-h) + var(--safe-bottom));
+  background: var(--bg2); border-top: 1px solid var(--border);
+  color: var(--text2); font-size: var(--fs-sm); line-height: 1.45;
+}
