+          updateNavIndicator();
+          if (now < stopAt) navSyncRAF = requestAnimationFrame(step);
+        };
+        navSyncRAF = requestAnimationFrame(step);
+      }
+      // Also stay in sync if the user manually swipes the nav bar itself.
+      bottomNav.addEventListener('scroll', () => trackNavIndicator(150), { passive: true });
