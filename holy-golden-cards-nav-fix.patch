From 0a5cbf34a4fd41cbf3626cd09a4185c5122e6eb2 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 8 Oct 2026 10:55:20 +0300
Subject: [PATCH] Restore original golden cards; stop Request button and nav
 labels being trimmed

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HMz7Hx1S3UR1ZoBBRD3Qqi
---
 frontend/styles.css | 67 ++++++++++++++++++++++-----------------------
 1 file changed, 32 insertions(+), 35 deletions(-)

diff --git a/frontend/styles.css b/frontend/styles.css
index e86a15f..6dce316 100644
--- a/frontend/styles.css
+++ b/frontend/styles.css
@@ -10616,31 +10616,6 @@ body.in-call .fab-menu { display: none !important; }
 html { -webkit-tap-highlight-color: transparent; }
 body { -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; overscroll-behavior: none; }
 
-/* nav labels never clip — "Live" fits, and any longer translation ellipsises cleanly */
-.nav-item span:not(.nav-badge) { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
-
-.card, .stat-card, .mentor-card {
-  background: linear-gradient(160deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.015)), var(--surface);
-  border: 1px solid rgba(201, 168, 76, 0.14);
-  box-shadow: 0 10px 28px rgba(0, 0, 0, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.06);
-  transition: transform 0.18s ease, box-shadow 0.25s ease, border-color 0.25s ease;
-}
-.card:active, .mentor-card:active, .stat-card:active { transform: scale(0.985); }
-
-.btn { transition: transform 0.15s ease, box-shadow 0.25s ease, filter 0.2s ease; }
-.btn:active { transform: scale(0.96); }
-.btn-primary {
-  background: linear-gradient(180deg, #EBCD72 0%, #C9A84C 100%);
-  color: #1a1300;
-  font-weight: 700;
-  letter-spacing: 0.02em;
-  border: 0;
-  box-shadow: 0 10px 24px rgba(201, 168, 76, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.35);
-}
-.btn-outline { border-color: rgba(201, 168, 76, 0.4); background: rgba(201, 168, 76, 0.05); }
-
-.app-header h2, .verse-card { letter-spacing: 0.01em; }
-.verse-card { box-shadow: 0 14px 36px rgba(0, 0, 0, 0.35), 0 0 30px rgba(201, 168, 76, 0.08); }
 
 /* glass bottom sheets / modals */
 .modal-overlay { backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
@@ -10658,19 +10633,41 @@ input:focus, textarea:focus, select:focus {
 /* thin gold scrollbars where shown (desktop / Telegram Desktop) */
 * { scrollbar-width: thin; scrollbar-color: rgba(201, 168, 76, 0.35) transparent; }
 
-[data-theme="light"] .card, [data-theme="light"] .stat-card, [data-theme="light"] .mentor-card {
-  background: linear-gradient(160deg, #fff, #FBF8F0);
-  border-color: rgba(150, 120, 40, 0.18);
-  box-shadow: 0 8px 22px rgba(30, 25, 15, 0.1), inset 0 1px 0 #fff;
-}
-
-@media (prefers-reduced-motion: reduce) {
-  .card, .btn, .stat-card, .mentor-card { transition: none; }
-}
-
 /* Chat: last message must clear the floating nav + input row. --chat-covered is
    measured in app.js (syncChatCoveredSpace); the old estimate is the fallback. */
 .chat-messages {
   padding-bottom: var(--chat-covered, calc(var(--chat-input-h, 90px) + var(--nav-h) + var(--safe-bottom) + 12px));
   scroll-padding-bottom: var(--chat-covered, 120px);
 }
+
+/* Nav tabs share the pill's width equally and shrink their label to fit, so
+   longer labels ("Requests", "Mentees", Amharic) are never cut off. */
+.bottom-nav { overflow: visible; }
+.nav-item {
+  flex: 1 1 0;
+  min-width: 0;
+  padding: 4px 1px;
+  overflow: visible;
+}
+.nav-item span:not(.nav-badge) {
+  max-width: none;
+  overflow: visible;
+  text-overflow: clip;
+  white-space: nowrap;
+  font-size: clamp(0.54rem, 2.5vw, 0.66rem);
+  letter-spacing: 0;
+}
+.nav-item svg { width: 21px; height: 21px; }
+
+/* Mentor "Request" button: always as wide as its label, never squeezed or clipped
+   by the card's flex row (the label is longer in Amharic and in the sheet). */
+.mentor-actions-group { flex-shrink: 0; }
+.btn-mentor-request, .btn-mentor-request.btn-sm {
+  flex-shrink: 0;
+  width: auto;
+  min-width: max-content;
+  white-space: nowrap;
+  overflow: visible;
+  padding-left: 18px;
+  padding-right: 18px;
+}
-- 
