--- a/frontend/styles.css
+++ b/frontend/styles.css
@@ -11625,3 +11625,131 @@
   .mc-footer { justify-content: flex-start; }
   .mc-view { flex: 0 0 auto; }
 }
+
+/* ─── Topic / mentee picker cards: long names wrap, nothing is clipped ─────── */
+.rt-topic {
+  height: auto;
+  min-height: 64px;
+  align-items: center;
+}
+.rt-topic .profile-menu-label.rt-label {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: 6px;
+  min-width: 0;
+}
+.rt-topic .rt-name {
+  display: block;
+  max-width: 100%;
+  font-size: 0.98rem;
+  line-height: 1.3;
+  overflow-wrap: anywhere;
+  word-break: normal;
+  white-space: normal;
+}
+.rt-topic .mp-mine-chip { margin-left: 0; white-space: nowrap; }
+.rt-topic .profile-menu-icon, .rt-topic .rt-radio, .rt-topic .profile-menu-chevron { flex: none; }
+.rt-topic .sch-sub, .sch-person .sch-sub { font-size: 0.76rem; font-weight: 500; color: var(--text2); }
+
+/* ─── Live page: schedule sheet + pickers match the other sheets ─────────── */
+.sch-sheet { padding-bottom: calc(20px + env(safe-area-inset-bottom, 0px)); }
+.sch-title { text-align: center; font-size: 1.15rem; margin-bottom: 14px; }
+.sch-sheet .form-group { margin-bottom: 14px; }
+.sch-sheet .form-label { margin-left: 4px; }
+.sch-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
+@media (max-width: 340px) { .sch-grid { grid-template-columns: 1fr; } }
+.sch-input,
+.sch-sheet .form-control {
+  min-height: 52px;
+  padding: 0 16px;
+  border-radius: 18px;
+  border: 1px solid rgba(255, 255, 255, 0.09);
+  background: linear-gradient(160deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.015)), #111319;
+  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
+  font-size: 1rem;
+  font-weight: 600;
+  color: var(--text);
+  color-scheme: dark;
+  -webkit-appearance: none;
+  appearance: none;
+}
+.sch-sheet input[type="date"], .sch-sheet input[type="time"] { min-width: 0; text-align: left; }
+.sch-sheet .form-control:focus {
+  border-color: var(--gold-light);
+  box-shadow: 0 0 0 3px rgba(201, 168, 76, 0.22);
+}
+[data-theme="light"] .sch-input,
+[data-theme="light"] .sch-sheet .form-control {
+  background: #fffaf0;
+  border-color: rgba(150, 120, 40, 0.3);
+  color-scheme: light;
+}
+.sch-people {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  max-height: 32vh;
+  overflow-y: auto;
+  padding: 2px;
+  -webkit-overflow-scrolling: touch;
+}
+.sch-person {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  min-height: 60px;
+  padding: 10px 14px;
+  border-radius: 20px;
+  border: 1px solid rgba(255, 255, 255, 0.07);
+  background: linear-gradient(160deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.015)), #111319;
+  cursor: pointer;
+  transition: border-color 0.2s ease, background 0.2s ease, transform 0.15s ease;
+}
+.sch-person:active { transform: scale(0.985); }
+.sch-person input { position: absolute; opacity: 0; pointer-events: none; }
+.sch-person-name { flex: 1; min-width: 0; font-weight: 600; overflow-wrap: anywhere; line-height: 1.3; }
+.sch-person:has(input:checked) {
+  border-color: rgba(201, 168, 76, 0.6);
+  background: linear-gradient(160deg, rgba(201, 168, 76, 0.2), rgba(201, 168, 76, 0.06)), #14130d;
+}
+.sch-person:has(input:checked) .rt-radio {
+  border-color: var(--gold-light);
+  background: linear-gradient(180deg, #EBCD72, #C9A84C);
+  box-shadow: 0 0 14px rgba(201, 168, 76, 0.55);
+}
+.sch-person:has(input:checked) .rt-radio::after {
+  content: '';
+  position: absolute;
+  left: 7px; top: 3px;
+  width: 6px; height: 11px;
+  border: solid #1a1300;
+  border-width: 0 2.5px 2.5px 0;
+  transform: rotate(45deg);
+}
+.sch-person:has(input:focus-visible) { outline: 2px solid var(--gold-light); outline-offset: 2px; }
+[data-theme="light"] .sch-person { background: #fffaf0; border-color: rgba(150, 120, 40, 0.28); }
+
+/* Live page session rows: action buttons hug their text, same pill shape as elsewhere */
+.session-item .session-action .btn,
+.session-item .session-action .btn-sm {
+  width: auto;
+  min-width: max-content;
+  min-height: 38px;
+  padding: 0 18px;
+  border-radius: 999px;
+  white-space: nowrap;
+  font-weight: 700;
+}
+.session-item .session-action > div { align-items: stretch; }
+.session-item .session-body { flex: 1 1 140px; min-width: 0; }
+.session-item .session-title {
+  white-space: normal;
+  display: -webkit-box;
+  -webkit-line-clamp: 2;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+  line-height: 1.3;
+  overflow-wrap: anywhere;
+}
+.session-item .session-action { flex: 0 0 auto; margin-left: auto; }
