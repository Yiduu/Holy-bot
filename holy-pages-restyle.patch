 }
 @media (prefers-reduced-motion: reduce) { .profile-pane.active { animation: none; } }
+
+
+/* ─── Same look on the other pages ───────────────────────────────
+   Gold glow behind the header, pill segmented tabs, rounder cards, gold icon
+   tiles. Cards keep their own backgrounds (golden stays golden): only shape,
+   shadow and spacing change here. ─── */
+:is(#page-dashboard, #page-mentors, #page-sessions, #page-requests, #page-my-mentees,
+    #page-journal, #page-support, #page-ticket-detail).active {
+  background: radial-gradient(120% 360px at 50% 0%, rgba(201, 168, 76, 0.24) 0%, rgba(168, 124, 42, 0.09) 45%, transparent 78%) no-repeat;
+}
+[data-theme="light"] :is(#page-dashboard, #page-mentors, #page-sessions, #page-requests, #page-my-mentees,
+    #page-journal, #page-support, #page-ticket-detail).active {
+  background: radial-gradient(120% 360px at 50% 0%, rgba(201, 168, 76, 0.30) 0%, rgba(201, 168, 76, 0.09) 45%, transparent 78%) no-repeat;
+}
+
+/* pill segmented tabs (Browse | Saved, and any .segmented-control) */
+.mentor-tabs-segmented {
+  gap: 4px;
+  padding: 5px;
+  border-radius: 999px;
+  background: rgba(255, 255, 255, 0.04);
+  border: 1px solid rgba(255, 255, 255, 0.08);
+  box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.25);
+}
+.mentor-tab-btn {
+  height: 40px;
+  padding: 0 14px;
+  border-radius: 999px;
+  font-size: 0.88rem;
+  font-weight: 600;
+  color: var(--text2);
+}
+.mentor-tab-btn.active {
+  color: #1a1300;
+  background: linear-gradient(180deg, #EBCD72, #C9A84C);
+  box-shadow: 0 8px 20px rgba(201, 168, 76, 0.38), inset 0 1px 0 rgba(255, 255, 255, 0.4);
+}
+.mentor-tab-btn.active .mentor-tab-badge { background: #1a1300; color: var(--gold-light); }
+[data-theme="light"] .mentor-tabs-segmented { background: rgba(255, 255, 255, 0.7); border-color: rgba(150, 120, 40, 0.2); box-shadow: inset 0 2px 6px rgba(30, 25, 15, 0.08); }
+
+/* rounder, softer cards */
+.card { border-radius: 22px; }
+.stat-card { border-radius: 20px; padding: 14px 10px; }
+.mentor-card { border-radius: 24px; }
+.session-item { border-radius: 22px; padding: 14px 16px; gap: 14px; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.28), var(--inset-hi); }
+.session-item::before { left: 16px; right: 16px; }
+.journal-item { border-radius: 22px; padding: 16px 18px; }
+.ticket-card-premium { border-radius: 22px; padding: 18px 18px 18px 20px; }
+.mentee-card { border-radius: 22px; }
+.mentee-card::before { border-radius: 22px 22px 0 0; }
+
+/* gold icon tile on session rows (was blue) */
+.session-icon {
+  width: 46px;
+  height: 46px;
+  border-radius: 16px;
+  background: rgba(201, 168, 76, 0.13);
+  border: 0;
+  box-shadow: inset 0 0 0 1px rgba(201, 168, 76, 0.24);
+}
+.session-icon svg { stroke: var(--gold-light); }
+[data-theme="light"] .session-icon { background: rgba(201, 168, 76, 0.18); }
+[data-theme="light"] .session-icon svg { stroke: #7A5812; }
+
+/* big, friendly action buttons in two-up rows (Start a session, quick actions) */
+.grid-2 > .btn { min-height: 52px; border-radius: 18px; }
+
+/* let the gold page glow show through the header */
+:is(#page-dashboard, #page-mentors, #page-sessions, #page-requests, #page-my-mentees,
+    #page-journal, #page-support, #page-ticket-detail).active .app-header {
+  background: transparent;
+  border-bottom-color: transparent;
+}
-- 
