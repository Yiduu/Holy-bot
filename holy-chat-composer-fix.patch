diff --git a/frontend/chat-media.css b/frontend/chat-media.css
index ac12d0f..e34af2d 100644
--- a/frontend/chat-media.css
+++ b/frontend/chat-media.css
@@ -1145,3 +1145,49 @@
   -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 1px));
   mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 1px));
 }
+
+/* ═══ Chat composer: no more messages showing around / under it ═══════════════
+   The composer stays position:fixed (anchored to the real screen, so it can
+   never end up below the visible area on phones). What made it look like it was
+   "floating over the chat" was the gap around the floating nav pill: messages
+   scrolled past in that gap and under the composer's shadow.
+
+   Fix: the composer's solid background now runs all the way down to the bottom
+   of the screen, behind the nav pill. Its content sits exactly where it did
+   before (the extra padding equals the nav's footprint), so nothing moves.     */
+.chat-input-row {
+  bottom: 0;
+  padding-bottom: calc(10px + var(--nav-h) + var(--safe-bottom));
+  background: var(--bg2);
+  box-shadow: none;
+  border-top: 1px solid var(--border);
+}
+
+/* the popups open above the composer; keep them clear of the taller row */
+.chat-input-row .emoji-picker,
+.cm-attach-menu {
+  bottom: calc(100% - var(--nav-h) - var(--safe-bottom) + 8px);
+}
