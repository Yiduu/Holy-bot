+
+
+/* ═══ Mentor profile: specialization + about read as paragraphs ═══════════════
+   Small icon + label on one line, text below it from the far left edge at full width. ═══ */
+.mp-info.mp-para { flex-direction: column; align-items: stretch; justify-content: flex-start; gap: 12px; min-height: 0; padding: 16px 18px 18px; text-align: left; }
+.mp-para-head { display: flex; align-items: center; gap: 10px; min-width: 0; }
+.mp-para .profile-menu-icon { width: 34px; height: 34px; border-radius: 12px; flex: none; }
+.mp-para .profile-menu-icon svg { width: 17px; height: 17px; }
+.mp-para .mp-info-label { flex: 1; min-width: 0; }
+.mp-para .mp-info-text { display: block; width: 100%; padding: 0; font-size: var(--fs-md); font-weight: 400; line-height: 1.7; text-align: left; white-space: pre-wrap; overflow-wrap: anywhere; }
+.mp-panel .mp-para .mp-info-text { text-align: left; }
