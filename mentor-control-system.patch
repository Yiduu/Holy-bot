+                    `).join('');
+                }
+
+                if (!m.recent_actions?.length) {
+                    activityC.innerHTML = `<div class="empty" style="padding:10px 0">No recorded admin actions</div>`;
+                } else {
+                    activityC.innerHTML = `<div style="display:flex;flex-direction:column;gap:8px">${m.recent_actions.map(a => `
+                        <div style="font-size:12px;padding:8px 10px;border-radius:8px;background:var(--bg3)">
+                            <div style="display:flex;justify-content:space-between">
+                                <strong>${esc(a.action)}</strong>
+                                <span style="color:var(--text3)">${ago(a.created_at)}</span>
+                            </div>
+                            ${a.details && Object.keys(a.details).length ? `<div style="color:var(--text2);margin-top:2px">${esc(JSON.stringify(a.details))}</div>` : ''}
+                        </div>
+                    `).join('')}</div>`;
+                }
+            } catch (e) {
+                infoC.innerHTML = `<div class="empty" style="color:var(--danger)">Error: ${e.message}</div>`;
+                menteesC.innerHTML = ''; activityC.innerHTML = '';
+            }
+        }
+
+        async function saveMcNotes() {
+            if (!mcCurrentId) return;
+            const notes = document.getElementById('mcNotesText').value;
+            const btn = document.getElementById('mcNotesSaveBtn');
+            btn.disabled = true; btn.textContent = 'Saving…';
+            try {
+                await api(`/api/admin/mentor-control/mentors/${mcCurrentId}/notes`, { method: 'PUT', body: { notes } });
+                toast('Notes saved', 'success');
+                loadMentorControl(mcPage);
+            } catch (e) {
+                toast(e.message, 'error');
+            } finally {
+                btn.disabled = false; btn.textContent = 'Save Notes';
+            }
+        }
+
+        async function mcUnassign(mentorId, menteeId) {
+            if (!confirm('End this specific mentor–mentee pairing? Both parties will be notified.')) return;
+            try {
+                await api(`/api/admin/mentor-control/mentors/${mentorId}/mentees/${menteeId}/unassign`, { method: 'PATCH' });
+                toast('Mentee unassigned', 'success');
+                if (mcCurrentId === mentorId) loadMcDetail(mentorId);
+                loadMentorControl(mcPage); loadMcStats();
+            } catch (e) { toast(e.message, 'error'); }
+        }
+
+        async function mcDisqualify(tid) {
+            if (!confirm('Permanently disqualify this mentor? Their role reverts to a regular user and ALL active mentees are unassigned. This cannot be undone from here.')) return;
+            try {
+                await api(`/api/admin/mentors/${tid}/disqualify`, { method: 'PATCH' });
