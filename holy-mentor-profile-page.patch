+  border-radius: 999px;
+  font-size: 0.95rem;
+  font-weight: 700;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  white-space: nowrap;
+}
+.mp-actions .btn-danger { background: transparent; border: 1px solid rgba(224, 92, 92, 0.55); color: var(--danger); }
+
+/* stat tiles */
+.mp-stats {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 10px;
+  margin: 2px 2px 18px;
+}
+.mp-stat-of { font-size: 0.8rem; color: var(--text3); text-shadow: none; }
+
+/* info cards = the Profile menu cards, minus the tap behavior */
+.mp-info { cursor: default; align-items: flex-start; }
+.mp-info:hover { background: linear-gradient(160deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.015)), #111319; }
+.mp-info.pm-gold:hover {
+  background:
+    radial-gradient(120% 140% at 0% 0%, rgba(201, 168, 76, 0.22) 0%, rgba(201, 168, 76, 0.06) 55%, transparent 100%),
+    #17140c;
+}
+[data-theme="light"] .mp-info:hover { background: linear-gradient(160deg, #fff, #f6f3ea); }
+[data-theme="light"] .mp-info.pm-gold:hover {
+  background: radial-gradient(120% 140% at 0% 0%, rgba(201, 168, 76, 0.28), rgba(201, 168, 76, 0.08) 60%, #fffaf0);
+}
+.mp-info:active { transform: none; }
+.mp-info .profile-menu-icon { flex: none; }
+.mp-info-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; padding-top: 2px; }
+.mp-info-label {
+  font-size: 0.7rem;
+  font-weight: 700;
+  letter-spacing: 0.16em;
+  text-transform: uppercase;
+  color: var(--gold-light);
+}
+[data-theme="light"] .mp-info-label { color: #7A5812; }
+.mp-info-text {
+  font-size: 0.95rem;
+  font-weight: 500;
+  line-height: 1.55;
+  color: var(--text);
+  white-space: pre-wrap;
+  overflow-wrap: anywhere;
+}
+.mp-info.pm-gold .mp-info-text { color: var(--text); }
+
+/* Age + Gender side by side */
+.mp-duo { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
+.mp-info-duo { min-height: 74px; padding: 14px; gap: 12px; align-items: center; }
+.mp-info-duo .profile-menu-icon { width: 42px; height: 42px; border-radius: 14px; }
+.mp-info-duo .mp-info-body { padding-top: 0; }
+.mp-info-duo .mp-info-text { font-size: 1rem; font-weight: 700; line-height: 1.2; }
+.mp-info-duo .mp-info-label { letter-spacing: 0.12em; }
+
+/* topics */
+.mp-topic { align-items: center; min-height: 66px; }
+.mp-topic .profile-menu-label { font-size: 1rem; }
+.mp-mine-chip {
+  flex: none;
+  padding: 5px 11px;
+  border-radius: 999px;
+  font-size: 0.7rem;
+  font-weight: 700;
+  letter-spacing: 0.04em;
+  color: #1a1300;
+  background: linear-gradient(180deg, #EBCD72, #C9A84C);
+  box-shadow: 0 4px 12px rgba(201, 168, 76, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.4);
+}
+
+@media (max-width: 360px) {
+  .mp-actions { flex-direction: column; }
+  .mp-duo { grid-template-columns: 1fr; }
+}
+@media (prefers-reduced-motion: reduce) { #page-mentor-profile .page-content { animation: none; } }
