# Copy this to .env and fill in real values. Never commit .env.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram user ID of the admin account (used to gate /api/admin routes
# and the admin.html dashboard). It is ALSO the storage chat: profile photos and
# every voice message / file sent from the Mini App are uploaded to this
# account's chat with the bot, only to obtain a permanent Telegram file_id.
# The admin must have started the bot. Use a dedicated private account if you
# don't want that chat to fill up with attachments.
ADMIN_TELEGRAM_ID=

# Supabase project settings (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL the Telegram Mini App is served from, e.g. https://yourapp.onrender.com
MINI_APP_URL=

# Locks down CORS to this origin in production. Leave unset for local dev
# (falls back to '*'), but set it before going live.
ALLOWED_ORIGIN=

# Optional. Sentry DSN for error tracking — leave blank to skip it entirely.
SENTRY_DSN=

# development or production. Affects a couple of auth checks in server.js.
NODE_ENV=development

# Port the Express server listens on. Render sets this automatically.
PORT=3000

# ── Live video sessions ──────────────────────────────────────────────────────
# The ONE Jitsi server used by the embedded call AND the "open in browser"
# fallback. Both sides must share it or they end up in different rooms.
# Defaults to the public meet.opensuse.org the embed has always used. For
# production, self-host Jitsi (or use JaaS) and set the two values below so
# rooms are protected by signed tokens instead of a shared password.
JITSI_DOMAIN=
JITSI_APP_ID=
JITSI_JWT_SECRET=

# Safety cap: a live session is closed by the server after this many hours.
SESSION_MAX_HOURS=4

# ── Built-in 1-on-1 audio call (optional; Jitsi stays the default) ──────────
# Set to p2p to give 1-on-1 sessions the built-in audio call. Groups always use Jitsi.
# CALL_PROVIDER=p2p
# Relay for networks that block direct calls — pick ONE (all have a free tier). With none set,
# the call still works for most people (STUN only).
# Cloudflare Realtime TURN (1,000 GB/month free):
# CF_TURN_KEY_ID=
# CF_TURN_API_TOKEN=
# Metered Open Relay (20 GB/month free):
# METERED_TURN_APP=
# METERED_TURN_API_KEY=
# Your own coturn:
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=
