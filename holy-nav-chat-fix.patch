diff --git a/frontend/nav-toggle.css b/frontend/nav-toggle.css
new file mode 100644
index 0000000..2a6c745
--- /dev/null
+++ b/frontend/nav-toggle.css
@@ -0,0 +1,292 @@
+/* ═══════════════════════════════════════════════════════════════════════════
+   nav-toggle.css — collapsible bottom navigation + non-floating chat composer
+   Loaded LAST (after styles.css, goals.css, chat-media.css) so it wins.
+
+   1. The bottom nav is hidden by default. A small handle at the bottom edge
+      opens it; choosing a tab, tapping outside, swiping down, pressing Esc
+      or focusing a text field closes it again. (nav-toggle.js)
+   2. The nav no longer permanently covers the page, so pages only reserve a
+      thin strip (--nav-h) for the handle instead of the old 68-82px.
+   3. The chat composer is part of the page layout (not position:fixed), so it
+      never floats over the messages while scrolling.
+   ═══════════════════════════════════════════════════════════════════════════ */
+
+/* --nav-h is what every page reserves at the bottom. With the nav collapsed
+   that is just the handle strip. --nav-full is the nav's real height. */
+:root {
+  --nav-h: 30px;
+  --nav-full: 68px;
+}
+
+/* ── Bottom navigation: refined floating panel ─────────────────────────── */
+.bottom-nav {
+  left: 12px;
+  right: 12px;
+  width: auto;
+  bottom: calc(var(--safe-bottom) + 10px);
+  height: var(--nav-full);
+  padding: 0 8px;
+  gap: 2px;
+  align-items: center;
+  border-radius: 20px;
+  background: var(--bg2);
+  border: 1px solid var(--border);
+  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45), 0 2px 6px rgba(0, 0, 0, 0.25);
+  backdrop-filter: none;
+  -webkit-backdrop-filter: none;
+  overflow: hidden;
+  z-index: 9999;
+
+  /* collapsed state */
+  transform: translateY(calc(100% + var(--safe-bottom) + 24px));
+  opacity: 0;
+  visibility: hidden;
+  pointer-events: none;
+  transition: transform 0.28s cubic-bezier(0.22, 0.8, 0.3, 1),
+              opacity 0.2s ease,
+              visibility 0s linear 0.28s;
+}
+
+body.nav-open .bottom-nav {
+  transform: translateY(0);
+  opacity: 1;
+  visibility: visible;
+  pointer-events: auto;
+  transition: transform 0.28s cubic-bezier(0.22, 0.8, 0.3, 1),
+              opacity 0.2s ease,
+              visibility 0s;
+}
+
+[data-theme="light"] .bottom-nav {
+  background: var(--bg2);
+  border-color: rgba(150, 120, 40, 0.28);
+  box-shadow: 0 14px 34px rgba(30, 25, 15, 0.18), 0 2px 6px rgba(30, 25, 15, 0.1);
+}
+
+.bottom-nav .nav-item {
+  flex: 1 1 0;
+  min-width: 0;
+  align-self: stretch;
+  margin: 8px 0;
+  padding: 4px 2px;
+  gap: 4px;
+  border-radius: 14px;
+  color: var(--text3);
+  background: transparent;
+  box-shadow: none;
+  position: relative;
+  transition: color 0.18s ease, background-color 0.18s ease;
+}
+
+.bottom-nav .nav-item svg {
+  width: 22px;
+  height: 22px;
+  stroke-width: 1.8;
+}
+
+.bottom-nav .nav-item span:not(.nav-badge) {
+  font-size: clamp(0.58rem, 2.7vw, 0.68rem);
+  font-weight: 600;
+  letter-spacing: 0.01em;
+  white-space: nowrap;
+}
+
+.bottom-nav .nav-item:active {
+  background: var(--surface);
+}
+
+/* active tab: gold icon + label with a soft tint and a small indicator bar */
+.bottom-nav .nav-item.active {
+  color: var(--gold-light, #E8C96B);
+  background: rgba(201, 168, 76, 0.12);
+  box-shadow: none;
+}
+
+.bottom-nav .nav-item.active::after {
+  content: "";
+  display: block;
+  position: absolute;
+  top: 0;
+  left: 50%;
+  width: 18px;
+  height: 3px;
+  margin-left: -9px;
+  border-radius: 0 0 3px 3px;
+  background: var(--gold, #C9A84C);
+}
+
+[data-theme="light"] .bottom-nav .nav-item.active {
+  color: #6B4E0F;
+  background: rgba(150, 120, 40, 0.12);
+}
+
+[data-theme="light"] .bottom-nav .nav-item.active::after {
+  background: #8A6A1C;
+}
+
+/* the goals form used to slide the nav away; the nav is already hidden then */
+body.hg-typing .bottom-nav {
+  transform: translateY(calc(100% + var(--safe-bottom) + 24px));
+}
+
+/* ── Dim layer behind the open nav (tap it to close) ───────────────────── */
+.nav-scrim {
+  position: fixed;
+  inset: 0;
+  z-index: 9990;
+  background: rgba(0, 0, 0, 0.28);
+  opacity: 0;
+  visibility: hidden;
+  transition: opacity 0.2s ease, visibility 0s linear 0.2s;
+  -webkit-tap-highlight-color: transparent;
+}
+
+body.nav-open .nav-scrim {
+  opacity: 1;
+  visibility: visible;
+  transition: opacity 0.2s ease, visibility 0s;
+}
+
+/* ── Handle that opens the nav ─────────────────────────────────────────── */
+.nav-toggle {
+  position: fixed;
+  left: 50%;
+  bottom: var(--safe-bottom);
+  transform: translateX(-50%);
+  z-index: 9980;
+  width: 64px;
+  height: 24px;
+  margin: 0;
+  padding: 0;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  color: var(--text2);
+  background: var(--bg2);
+  border: 1px solid var(--border);
+  border-bottom: 0;
+  border-radius: 12px 12px 0 0;
+  cursor: pointer;
+  -webkit-tap-highlight-color: transparent;
+  transition: color 0.18s ease, opacity 0.18s ease, background-color 0.18s ease;
+}
+
+/* larger invisible tap target around the handle */
+.nav-toggle::before {
+  content: "";
+  position: absolute;
+  inset: -8px -22px 0 -22px;
+}
+
+.nav-toggle:hover,
+.nav-toggle:active {
+  color: var(--gold-light, #E8C96B);
+}
+
+.nav-toggle:focus-visible {
+  outline: 2px solid var(--gold, #C9A84C);
+  outline-offset: 2px;
+}
+
+.nav-toggle svg {
+  width: 18px;
+  height: 18px;
+  fill: none;
+  stroke: currentColor;
+  stroke-width: 2.4;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+  pointer-events: none;
+}
+
+/* unread dot, shown when any tab badge (chat, live, requests) is active */
+.nav-toggle .nav-toggle-dot {
+  display: none;
+  position: absolute;
+  top: 3px;
+  right: 12px;
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  background: #e5484d;
+  border: 1.5px solid var(--bg2);
+}
+
+.nav-toggle.has-badge .nav-toggle-dot {
+  display: block;
+}
+
+body.nav-open .nav-toggle {
+  opacity: 0;
+  pointer-events: none;
+}
+
+/* no nav or handle while in a call */
+body.in-call .nav-toggle,
+body.in-call .nav-scrim {
+  display: none !important;
+}
+
+/* keyboard-safe: handle tucks away while typing */
+body.hg-typing .nav-toggle {
+  opacity: 0;
+  pointer-events: none;
+}
+
+@media (orientation: landscape) and (max-height: 500px) {
+  :root {
+    --nav-h: 26px;
+    --nav-full: 52px;
+  }
+
+  .bottom-nav {
+    bottom: calc(var(--safe-bottom) + 6px);
+    border-radius: 16px;
+  }
+
+  .bottom-nav .nav-item {
+    margin: 4px 0;
+  }
+
+  .bottom-nav .nav-item span:not(.nav-badge) {
+    display: none;
+  }
+
+  .nav-toggle {
+    height: 20px;
+    width: 56px;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .bottom-nav,
+  .nav-scrim,
+  .nav-toggle {
+    transition: none !important;
+  }
+}
+
+/* ═══ Chat: the composer is part of the layout, not a floating overlay ═════
+   #page-chat is already a flex column (header, messages, composer). Taking the
+   composer out of position:fixed lets the message list end exactly where the
+   composer begins, so messages scroll *behind nothing* and never sit under it. */
+.chat-input-row {
+  position: relative;       /* still anchors the emoji picker / attach menu */
+  left: auto;
+  right: auto;
+  bottom: auto;
+  z-index: 5;
+  flex: 0 0 auto;
+  box-shadow: none;
+  border-top: 1px solid var(--border-dim);
+  padding-bottom: 10px;
+}
+
+#chatMessages.chat-messages {
+  flex: 1 1 auto;
+  min-height: 0;
+  /* no more space reserved for a floating composer / nav */
+  padding-bottom: 12px !important;
+  scroll-padding-bottom: 12px;
+  overscroll-behavior: contain;
+}
diff --git a/frontend/nav-toggle.js b/frontend/nav-toggle.js
new file mode 100644
index 0000000..f6b1439
--- /dev/null
+++ b/frontend/nav-toggle.js
@@ -0,0 +1,139 @@
+/* nav-toggle.js — collapsible bottom navigation.
+ *
+ * The nav is hidden until the user taps the handle at the bottom edge. It
+ * closes again when a tab is chosen, when the dim layer is tapped, on Escape,
+ * on a downward swipe, when a text field gets focus (so it never fights the
+ * keyboard), and after a few seconds of no interaction.
+ *
+ * Nothing in app.js needs to change: navigate() still runs through the tabs'
+ * existing inline onclick handlers.
+ */
+(function () {
+  'use strict';
+
+  var AUTO_CLOSE_MS = 8000;
+  var nav = document.querySelector('.bottom-nav');
+  if (!nav || document.getElementById('navToggle')) return;
+
+  var body = document.body;
+  var autoCloseTimer = 0;
+
+  /* ── Build the handle and the dim layer ─────────────────────────────── */
+  var toggle = document.createElement('button');
+  toggle.id = 'navToggle';
+  toggle.type = 'button';
+  toggle.className = 'nav-toggle';
+  toggle.setAttribute('aria-label', 'Open navigation menu');
+  toggle.setAttribute('aria-controls', 'bottomNav');
+  toggle.setAttribute('aria-expanded', 'false');
+  toggle.innerHTML =
+    '<svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="6 15 12 9 18 15"></polyline></svg>' +
+    '<span class="nav-toggle-dot" aria-hidden="true"></span>';
+
+  var scrim = document.createElement('div');
+  scrim.className = 'nav-scrim';
+  scrim.setAttribute('aria-hidden', 'true');
+
+  nav.id = nav.id || 'bottomNav';
+  nav.setAttribute('role', 'navigation');
+  nav.parentNode.insertBefore(scrim, nav);
+  nav.parentNode.insertBefore(toggle, nav);
+
+  /* ── Open / close ───────────────────────────────────────────────────── */
+  function isOpen() { return body.classList.contains('nav-open'); }
+
+  function setOpen(open) {
+    if (open === isOpen()) return;
+    body.classList.toggle('nav-open', open);
+    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
+    toggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
+    nav.setAttribute('aria-hidden', open ? 'false' : 'true');
+    clearTimeout(autoCloseTimer);
+    if (open) {
+      // dismiss the keyboard so the panel is not hidden behind it
+      var ae = document.activeElement;
+      if (ae && /^(INPUT|TEXTAREA|SELECT)$/.test(ae.tagName)) ae.blur();
+      autoCloseTimer = setTimeout(function () { setOpen(false); }, AUTO_CLOSE_MS);
+      try { window.Telegram && Telegram.WebApp && Telegram.WebApp.HapticFeedback && Telegram.WebApp.HapticFeedback.impactOccurred('light'); } catch (e) { }
+    }
+  }
+
+  function bumpAutoClose() {
+    if (!isOpen()) return;
+    clearTimeout(autoCloseTimer);
+    autoCloseTimer = setTimeout(function () { setOpen(false); }, AUTO_CLOSE_MS);
+  }
+
+  nav.setAttribute('aria-hidden', 'true');
+
+  toggle.addEventListener('click', function () { setOpen(!isOpen()); });
+  scrim.addEventListener('click', function () { setOpen(false); });
+
+  // choosing a tab closes the panel (the tab's own onclick still navigates)
+  nav.addEventListener('click', function (e) {
+    if (e.target.closest && e.target.closest('.nav-item')) {
+      setTimeout(function () { setOpen(false); }, 120);
+    } else {
+      bumpAutoClose();
+    }
+  });
+
+  document.addEventListener('keydown', function (e) {
+    if (e.key === 'Escape' && isOpen()) setOpen(false);
+  });
+
+  // typing in any field closes the nav so it never competes with the keyboard
+  document.addEventListener('focusin', function (e) {
+    var t = e.target;
+    if (isOpen() && t && /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName)) setOpen(false);
+  });
+
+  // swipe down on the open panel to dismiss it
+  var startY = null;
+  nav.addEventListener('touchstart', function (e) {
+    startY = e.touches[0].clientY;
+    bumpAutoClose();
+  }, { passive: true });
+  nav.addEventListener('touchmove', function (e) {
+    if (startY === null) return;
+    if (e.touches[0].clientY - startY > 28) { startY = null; setOpen(false); }
+  }, { passive: true });
+  nav.addEventListener('touchend', function () { startY = null; }, { passive: true });
+
+  // swipe up on the handle to open it
+  var hStartY = null;
+  toggle.addEventListener('touchstart', function (e) { hStartY = e.touches[0].clientY; }, { passive: true });
+  toggle.addEventListener('touchmove', function (e) {
+    if (hStartY === null) return;
+    if (hStartY - e.touches[0].clientY > 14) { hStartY = null; setOpen(true); }
+  }, { passive: true });
+  toggle.addEventListener('touchend', function () { hStartY = null; }, { passive: true });
+
+  /* ── Unread dot: the tab badges are invisible while the nav is hidden, so
+        mirror "any badge is showing" onto the handle. ───────────────────── */
+  function syncBadgeDot() {
+    var any = false;
+    nav.querySelectorAll('.nav-badge').forEach(function (b) {
+      var item = b.closest('.nav-item');
+      if (item && getComputedStyle(item).display === 'none') return;
+      if (getComputedStyle(b).display === 'none') return;
+      var n = parseInt((b.textContent || '').trim(), 10);
+      if (n > 0 || (isNaN(n) && (b.textContent || '').trim() !== '' && (b.textContent || '').trim() !== '0')) any = true;
+    });
+    toggle.classList.toggle('has-badge', any);
+  }
+
+  syncBadgeDot();
+  if (window.MutationObserver) {
+    new MutationObserver(syncBadgeDot).observe(nav, {
+      subtree: true,
+      childList: true,
+      characterData: true,
+      attributes: true,
+      attributeFilter: ['style', 'class']
+    });
+  }
+
+  // expose for other scripts (e.g. a future "open nav" shortcut)
+  window.holyNav = { open: function () { setOpen(true); }, close: function () { setOpen(false); }, toggle: function () { setOpen(!isOpen()); } };
+})();
