+.detail-tab.active { background: rgba(201, 168, 76, 0.16); color: var(--gold); box-shadow: inset 0 0 0 1px rgba(201, 168, 76, 0.25); }
+
+/* ─── Toast ──────────────────────────────────────────────────── */
