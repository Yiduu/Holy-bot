+}
+td.empty { display: table-cell; }
+.empty-state svg { width: 48px; height: 48px; stroke: var(--text3); opacity: 0.4; fill: none; stroke-width: 1.5; }
+
+/* shimmer skeletons (same motion as the app) */
+.skeleton-card::after {
+  background: linear-gradient(90deg, transparent, rgba(201, 168, 76, 0.07), transparent);
+}
+.skeleton-line { background: var(--bg3); border-radius: 6px; }
+
+/* ─── Misc ───────────────────────────────────────────────────── */
+.divider { background: var(--border-dim); }
+code.slug, .audit-action { border-radius: 6px; }
+.sidebar-dim { backdrop-filter: blur(3px); -webkit-backdrop-filter: blur(3px); }
+
+@media (max-width: 480px) {
+  .topbar, .sidebar { backdrop-filter: none !important; -webkit-backdrop-filter: none !important; }
+  .topbar { background: var(--bg2); }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .toast, .modal { animation: none !important; }
+}
