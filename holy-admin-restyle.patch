+/* admin.html centres the toast with translateX(-50%), so keep that in the keyframes */
+@keyframes adminToastIn {
+  from { opacity: 0; transform: translate(-50%, -8px); }
+  to { opacity: 1; transform: translate(-50%, 0); }
+}
+
+/* ─── Loading + empty states ─────────────────────────────────── */
+.loading {
