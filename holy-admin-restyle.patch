+.toggle.on { background: var(--gold); border-color: var(--gold); }
+.toggle.on::after { background: #fff; }
+
+/* ─── Tables ─────────────────────────────────────────────────── */
+table { font-size: var(--fs-sm); }
+thead th {
+  background: var(--bg3);
+  font-size: var(--fs-2xs);
+  letter-spacing: 0.1em;
+  color: var(--text3);
+}
+tbody tr { border-bottom: 1px solid var(--border-dim); }
