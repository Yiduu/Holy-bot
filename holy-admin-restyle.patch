+  tbody tr:hover { background: rgba(201, 168, 76, 0.06); }
+}
+tbody td { padding: 11px 12px; }
+.table-wrap { overflow-x: auto; }
+
+/* ─── Modals: bottom sheet on phones, centred card on desktop ── */
+.modal-overlay {
+  background: rgba(0, 0, 0, 0.7);
+  backdrop-filter: blur(4px);
+  -webkit-backdrop-filter: blur(4px);
+}
+.modal {
+  background: var(--bg2);
+  border: 1px solid var(--border-dim);
+  border-radius: var(--radius-card);
+  box-shadow: var(--shadow-lg), var(--inset-hi);
+  animation: adminModalIn 0.25s var(--ease-premium);
+}
+.modal-title {
+  font-size: var(--fs-base);
+  font-weight: 700;
+  color: var(--gold);
+  letter-spacing: 0.015em;
+}
+@keyframes adminModalIn {
+  from { opacity: 0; transform: translateY(14px) scale(0.985); }
+  to { opacity: 1; transform: none; }
+}
+@keyframes adminSheetIn {
+  from { transform: translateY(100%); }
+  to { transform: none; }
+}
+@media (max-width: 640px) {
