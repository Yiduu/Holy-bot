+    { mentor_id: mentorId, user_id: chatId, stars, created_at: new Date().toISOString() },
+    { onConflict: 'mentor_id,user_id' }
+  );
 
   clearState(chatId);
   await safeSend(chatId, tSync(lang, 'rating_submitted', { stars: '⭐'.repeat(stars) }));
