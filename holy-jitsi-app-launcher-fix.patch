diff --git a/frontend/open-app.html b/frontend/open-app.html
new file mode 100644
index 0000000..7d56a44
--- /dev/null
+++ b/frontend/open-app.html
@@ -0,0 +1,73 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
+<meta name="robots" content="noindex">
+<title>Open Jitsi Meet</title>
+<style>
+  :root { color-scheme: dark light; }
+  body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 20px;
+    font: 16px/1.45 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; background: #12100d; color: #ece7dc; }
+  main { width: 100%; max-width: 380px; text-align: center; display: flex; flex-direction: column; gap: 14px; }
+  h1 { font-size: 1.2rem; margin: 0; }
+  p { margin: 0; opacity: .75; font-size: .92rem; }
+  a.btn { display: block; padding: 14px; border-radius: 12px; font-weight: 700; text-decoration: none;
+    background: #c9a45c; color: #1a120b; }
+  a.ghost { background: transparent; color: inherit; border: 1px solid rgba(201,164,92,.5); font-weight: 600; }
+  .small { font-size: .82rem; }
+  .hidden { display: none; }
+  @media (prefers-color-scheme: light) { body { background: #f6f2ea; color: #1d1710; } }
+</style>
+</head>
+<body>
+<main>
+  <h1 id="title">Opening Jitsi Meet…</h1>
+  <p id="msg">If nothing happens, tap the button below.</p>
+  <a id="open" class="btn" href="#">Open Jitsi Meet app</a>
+  <p class="small" id="installLbl">Don't have the app yet?</p>
+  <a id="store" class="btn ghost" href="#">Install Jitsi Meet</a>
+  <a id="web" class="btn ghost hidden" href="#">Open in this browser instead</a>
+</main>
+<script>
+(function () {
+  // Parameters travel in the URL fragment (#d=…&r=…&j=…) so the room token is never sent to a server.
+  var p = new URLSearchParams(location.hash.slice(1));
+  var domain = p.get('d') || '', room = p.get('r') || '', jwt = p.get('j') || '';
+  var ua = navigator.userAgent || '';
+  var android = /Android/i.test(ua);
+  var ios = /iPad|iPhone|iPod/.test(ua) || (ua.indexOf('Macintosh') > -1 && navigator.maxTouchPoints > 1);
+  var PLAY = 'https://play.google.com/store/apps/details?id=org.jitsi.meet';
+  var APPSTORE = 'https://apps.apple.com/app/jitsi-meet/id1165103905';
+  var $ = function (id) { return document.getElementById(id); };
+
+  // Only plain hostnames and room slugs — nothing else is ever put into a URL.
+  var ok = /^[a-z0-9.-]+(:\d+)?$/i.test(domain) && /^[A-Za-z0-9_.~-]+$/.test(room) && /^[A-Za-z0-9_.~-]*$/.test(jwt);
+  if (!ok) { $('title').textContent = 'This link is not valid'; $('msg').textContent = 'Go back to the app and try again.'; ['open', 'installLbl', 'store'].forEach(function (i) { $(i).classList.add('hidden'); }); return; }
+
+  var query = jwt ? '?jwt=' + jwt : '';
+  var scheme = 'org.jitsi.meet://' + domain + '/' + room + query;
+  var web = 'https://' + domain + '/' + room + (jwt ? '#jwt=' + jwt : '');
+  var store = ios ? APPSTORE : PLAY;
+  // Android: an intent URL launches the app, or falls back to the Play Store if it is missing.
+  var intent = 'intent://' + domain + '/' + room + query + '#Intent;scheme=org.jitsi.meet;package=org.jitsi.meet;S.browser_fallback_url=' + encodeURIComponent(store) + ';end';
+  var target = android ? intent : scheme;
+
+  $('open').href = target;
+  $('store').href = store;
+  $('web').href = web;
+  if (!android && !ios) {            // computer: the app link makes no sense here
+    $('title').textContent = 'Open the session in your browser';
+    $('msg').textContent = 'Screen sharing works from a computer browser.';
+    $('open').classList.add('hidden'); $('installLbl').classList.add('hidden'); $('store').classList.add('hidden');
+    $('web').classList.remove('hidden'); $('web').className = 'btn';
+    return;
+  }
+  $('web').classList.remove('hidden');
+  // Try once automatically; the buttons are the fallback (iOS prefers a real tap).
+  if (android) setTimeout(function () { location.href = target; }, 250);
+  setTimeout(function () { $('title').textContent = 'Open Jitsi Meet'; }, 1500);
+})();
+</script>
+</body>
+</html>
diff --git a/frontend/session-room.js b/frontend/session-room.js
index d639811..ec761b4 100644
--- a/frontend/session-room.js
+++ b/frontend/session-room.js
@@ -336,6 +336,13 @@
   window.buildAppSessionUrl = function (data) {
     return `org.jitsi.meet://${data.jitsi_domain}/${data.room_name}` + (data.jitsi_token ? `?jwt=${data.jitsi_token}` : '');
   };
+  // https page (frontend/open-app.html) that launches the app from a real browser.
+  // Values go in the #fragment so the room token never reaches a server log.
+  window.buildAppLauncherUrl = function (data) {
+    const p = [`d=${encodeURIComponent(data.jitsi_domain)}`, `r=${encodeURIComponent(data.room_name)}`];
+    if (data.jitsi_token) p.push(`j=${encodeURIComponent(data.jitsi_token)}`);
+    return `${window.location.origin}/open-app.html#${p.join('&')}`;
+  };
 
   async function copyText(text) {
     try { if (navigator.clipboard?.writeText) { await navigator.clipboard.writeText(text); return true; } } catch (_) { /* try the fallback */ }
@@ -914,8 +921,10 @@
       if (pw && !A.passCopied) { A.passCopied = await copyText(pw); }
       if (!A) return;
       if (A.handoff === 'app') {
-        const url = window.buildAppSessionUrl(A.data);
-        try { window.location.href = url; } catch (_) { /* not supported here */ }
+        // Never navigate THIS page to org.jitsi.meet:// — Telegram's WebView shows an
+        // error page for unknown schemes. A small launcher page opened in the phone's
+        // real browser starts the app (and falls back to the store if it is missing).
+        openExternalUrl(window.buildAppLauncherUrl(A.data));
       } else {
         openExternalUrl(window.buildExternalSessionUrl(A.data, A.prefs));
       }
