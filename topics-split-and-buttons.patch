+
+/* ─── Mentor card footer — buttons fit their text (Instagram / LinkedIn style) ─
+   "View profile" is a compact pill that is exactly as wide as its icon + label
+   (no stretched empty space, no clipped text, works for Amharic too). The
+   primary action (Request / Waiting / Notify me) sits on the right, same height. */
+.mc-footer {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+}
+.mc-view {
+  flex: 0 0 auto;
+  width: auto;
+  min-width: 0;
+  max-width: 100%;
+  height: 40px;
+  gap: 8px;
+  padding: 0 8px 0 5px;
+  font-size: 0.84rem;
+  line-height: 1;
+  white-space: nowrap;
+}
+.mc-view-ico, .mc-view-arrow { width: 28px; height: 28px; }
+.mc-view-label {
+  flex: 0 1 auto;
+  overflow: visible;
+  text-overflow: clip;
+  padding: 0 2px;
+}
+.mc-card .mc-footer .btn,
+.mc-card .mc-footer .btn-sm {
+  flex: 0 0 auto;
+  width: auto;
+  min-width: max-content;
+  min-height: 40px;
+  height: 40px;
+  padding: 0 20px;
+  border-radius: 999px;
+  white-space: nowrap;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 6px;
+  line-height: 1;
+}
+/* very narrow phones: stack, and let each button hug its own text */
+@media (max-width: 360px) {
+  .mc-footer { justify-content: flex-start; }
+  .mc-view { flex: 0 0 auto; }
+}
