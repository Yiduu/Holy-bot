diff --git a/migrations/20261009_topics_separate_languages.sql b/migrations/20261009_topics_separate_languages.sql
new file mode 100644
index 0000000..c19d8f1
--- /dev/null
+++ b/migrations/20261009_topics_separate_languages.sql
@@ -0,0 +1,14 @@
+-- Split bilingual topic names ("English / አማርኛ") into two columns.
+--   topics.name     -> English only (same column, so existing queries keep working)
+--   topics.name_am  -> Amharic only (new)
+-- Safe to run more than once: only rows that still contain Ethiopic text are touched.
+-- The Amharic part starts at the first Ethiopic character, so a "/" inside either
+-- language ("Depression/anxiety", "ድብርት/ጭንቀት") is kept intact.
+
+ALTER TABLE topics ADD COLUMN IF NOT EXISTS name_am TEXT;
+
+UPDATE topics
+SET name_am = btrim(substring(name FROM '[\u1200-\u137F].*$')),
+    name    = btrim(regexp_replace(name, '\s*/\s*[\u1200-\u137F].*$', ''))
+WHERE name ~ '[\u1200-\u137F]'
+  AND name_am IS NULL;
