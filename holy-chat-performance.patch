+function makeTtlCache(ttlMs, max = 2000) {
+  const m = new Map();
+  return {
+    get(k) {
+      const e = m.get(k);
+      if (!e) return undefined;
+      if (e.exp < Date.now()) { m.delete(k); return undefined; }
+      return e.v;
