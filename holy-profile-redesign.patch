diff --git a/frontend/styles.css b/frontend/styles.css
index 6dce316..c75dc9e 100644
--- a/frontend/styles.css
+++ b/frontend/styles.css
@@ -10671,3 +10671,197 @@ input:focus, textarea:focus, select:focus {
   padding-left: 18px;
   padding-right: 18px;
 }
+
+/* ─── Profile page — "hero + segmented tabs + stacked cards" ───────────────
+   Deep-navy glow behind a big rounded-square photo, name, pill chips, a
+   segmented switch, then full-width rounded cards with an icon tile, label and
+   chevron. First card in each list is golden. Layout-only: every id/onclick
+   the app already uses is unchanged. ─── */
+#page-settings.active {
+  background:
+    radial-gradient(120% 420px at 50% 0%, rgba(58, 74, 168, 0.55) 0%, rgba(30, 38, 92, 0.32) 42%, transparent 78%),
+    radial-gradient(60% 240px at 50% 0%, rgba(201, 168, 76, 0.10) 0%, transparent 70%);
+  background-repeat: no-repeat;
+}
+[data-theme="light"] #page-settings.active {
+  background:
+    radial-gradient(120% 420px at 50% 0%, rgba(120, 140, 230, 0.28) 0%, rgba(120, 140, 230, 0.10) 45%, transparent 78%);
+  background-repeat: no-repeat;
+}
+#page-settings .app-header { background: transparent; border-bottom-color: transparent; box-shadow: none; }
+#page-settings .app-header h2 { opacity: 0; height: 0; margin: 0; pointer-events: none; }  /* title is redundant over the hero */
+
+.profile-hero { padding: 6px 12px 18px; }
+
+.profile-hero .avatar-preview-wrap {
+  padding: 5px;
+  border-radius: 34px;
+  background: linear-gradient(160deg, rgba(255, 255, 255, 0.10), rgba(255, 255, 255, 0.02));
+  border: 1px solid rgba(255, 255, 255, 0.10);
+  box-shadow: 0 18px 44px rgba(10, 14, 40, 0.65), 0 0 36px rgba(91, 110, 230, 0.22);
+}
+.avatar-preview-xl {
+  width: 112px;
+  height: 112px;
+  border-radius: 28px;
+  overflow: hidden;
+  font-size: 2.6rem;
+  border: 0;
+  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
+}
+.avatar-preview-xl img { width: 100%; height: 100%; object-fit: cover; border-radius: inherit; display: block; }
+.avatar-preview-xl:hover { box-shadow: inset 0 0 0 2px var(--gold); }
+
+.profile-hero-name {
+  margin-top: 16px;
+  max-width: 88%;
+  font-size: 1.5rem;
+  letter-spacing: 0.02em;
+  text-shadow: 0 2px 18px rgba(0, 0, 0, 0.45);
+}
+
+.profile-pills {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  flex-wrap: wrap;
+  gap: 10px;
+  margin-top: 16px;
+}
+.profile-pills .chip, .profile-pill {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  height: 40px;
+  padding: 0 18px;
+  border-radius: 999px;
+  font-family: var(--font-body);
+  font-size: 0.9rem;
+  font-weight: 700;
+  color: var(--text);
+  background: rgba(255, 255, 255, 0.06);
+  border: 1px solid rgba(255, 255, 255, 0.12);
+  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.06);
+  white-space: nowrap;
+  cursor: pointer;
+  margin: 0;
+  transition: transform 0.15s ease, background 0.2s ease;
+}
+.profile-pills .chip { color: var(--gold-light); cursor: default; }
+.profile-pill:active { transform: scale(0.96); }
+.profile-pill svg { color: var(--gold-light); flex-shrink: 0; }
+[data-theme="light"] .profile-pills .chip, [data-theme="light"] .profile-pill {
+  background: rgba(255, 255, 255, 0.85); border-color: rgba(60, 70, 140, 0.18); color: var(--text);
+  box-shadow: 0 6px 16px rgba(30, 40, 90, 0.12);
+}
+[data-theme="light"] .profile-pills .chip { color: #6B4E0F; }
+
+/* segmented switch */
+.profile-tabs {
+  display: flex;
+  gap: 4px;
+  padding: 6px;
+  margin: 4px 2px 16px;
+  border-radius: 999px;
+  background: rgba(255, 255, 255, 0.04);
+  border: 1px solid rgba(255, 255, 255, 0.08);
+  box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.25);
+}
+.profile-tab {
+  position: relative;
+  flex: 1;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  height: 46px;
+  border: 0;
+  border-radius: 999px;
+  background: transparent;
+  color: var(--text2);
+  font-family: var(--font-body);
+  font-size: 1rem;
+  font-weight: 600;
+  cursor: pointer;
+  transition: background 0.25s ease, color 0.25s ease, box-shadow 0.25s ease;
+}
+.profile-tab.active {
+  color: #fff;
+  background: linear-gradient(180deg, #7584f5, #5b6bdc);
+  box-shadow: 0 8px 22px rgba(91, 107, 220, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.25);
+}
+.profile-tab-dot {
+  position: absolute; top: 9px; right: calc(50% - 56px);
+  width: 9px; height: 9px; border-radius: 50%;
+  background: var(--danger); box-shadow: 0 0 0 2px var(--bg);
+  display: none;
+}
+.profile-tab-dot.on { display: block; }
+[data-theme="light"] .profile-tabs { background: rgba(255, 255, 255, 0.7); border-color: rgba(60, 70, 140, 0.14); box-shadow: inset 0 2px 6px rgba(30, 40, 90, 0.08); }
+
+.profile-pane { display: none; }
+.profile-pane.active { display: block; animation: profilePaneIn 0.28s ease both; }
+@keyframes profilePaneIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
+
+/* stacked cards */
+.profile-section-title { display: none; }                      /* the tabs name the sections now */
+.profile-menu-list {
+  gap: 12px;
+  background: transparent;
+  border: 0;
+  border-radius: 0;
+  overflow: visible;
+  margin-bottom: 0;
+}
+.profile-menu-item {
+  min-height: 74px;
+  padding: 14px 18px;
+  gap: 16px;
+  border: 1px solid rgba(255, 255, 255, 0.07);
+  border-radius: 26px;
+  background: linear-gradient(160deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.015)), #111319;
+  box-shadow: 0 10px 26px rgba(0, 0, 0, 0.32), inset 0 1px 0 rgba(255, 255, 255, 0.05);
+  font-size: 1.02rem;
+  font-weight: 600;
+  transition: transform 0.15s ease, box-shadow 0.25s ease, border-color 0.25s ease;
+}
+.profile-menu-item:last-child { border-bottom: 1px solid rgba(255, 255, 255, 0.07); }
+.profile-menu-item:hover { background: linear-gradient(160deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.02)), #14161d; }
+.profile-menu-item:active { transform: scale(0.985); }
+.profile-menu-icon {
+  width: 48px;
+  height: 48px;
+  border-radius: 16px;
+  background: rgba(124, 138, 255, 0.14);
+  color: #aab4ff;
+  box-shadow: inset 0 0 0 1px rgba(124, 138, 255, 0.18);
+}
+.profile-menu-icon svg { width: 22px; height: 22px; }
+.profile-menu-chevron { width: 20px; height: 20px; color: var(--text2); }
+.profile-menu-trailing { font-size: 0.82rem; }
+
+/* first card of each list = the golden one */
+.profile-menu-list > .profile-menu-item:first-child {
+  border-color: rgba(201, 168, 76, 0.35);
+  background:
+    radial-gradient(120% 140% at 0% 0%, rgba(201, 168, 76, 0.22) 0%, rgba(201, 168, 76, 0.06) 55%, transparent 100%),
+    #17140c;
+  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.38), 0 0 26px rgba(201, 168, 76, 0.12), inset 0 1px 0 rgba(255, 233, 160, 0.12);
+}
+.profile-menu-list > .profile-menu-item:first-child .profile-menu-icon {
+  background: radial-gradient(circle at 30% 25%, #f1d786, #c9a84c 70%);
+  color: #2a1e05;
+  box-shadow: 0 6px 16px rgba(201, 168, 76, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.5);
+}
+
+[data-theme="light"] .profile-menu-item {
+  background: linear-gradient(160deg, #fff, #f6f3ea);
+  border-color: rgba(60, 70, 140, 0.12);
+  box-shadow: 0 8px 20px rgba(30, 40, 90, 0.10), inset 0 1px 0 #fff;
+}
+[data-theme="light"] .profile-menu-icon { background: rgba(91, 107, 220, 0.12); color: #4452c0; box-shadow: inset 0 0 0 1px rgba(91, 107, 220, 0.18); }
+[data-theme="light"] .profile-menu-list > .profile-menu-item:first-child {
+  background: radial-gradient(120% 140% at 0% 0%, rgba(201, 168, 76, 0.28), rgba(201, 168, 76, 0.08) 60%, #fffaf0);
+  border-color: rgba(150, 120, 40, 0.35);
+}
+@media (prefers-reduced-motion: reduce) { .profile-pane.active { animation: none; } }
-- 
